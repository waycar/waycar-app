---
// /carplay: Waycar in CarPlay (1.3.0, iPhone only). Two real photos of the
// car's screen (taken parked, cropped to the display, never retouched), and
// the rest is what you hear, in the app's own spoken lines
// (Sources/Waycar/Voice/CarVoiceScript.swift, v1.3.0). Keep it in step with the
// help pages carplay, carplay-voice and live-activities. Apple's rules:
// "CarPlay" never in caps (so never in a kicker), never more prominent than
// "Waycar", no Apple art, and captions never imply Apple's endorsement.
import { Image } from 'astro:assets';
import listPhoto from '../assets/carplay/carplay-list.jpg';
import voicePhoto from '../assets/carplay/carplay-voice.jpg';
import AppStoreCta from '../components/AppStoreCta.astro';
import VoiceExchange, { type ExchangeLine } from '../components/VoiceExchange.astro';
import { ON_APP_STORE } from '../data/links';
import Layout from '../layouts/Layout.astro';

const briefing: ExchangeLine[] = [
  { by: 'tap', text: 'Talk to Waycar' },
  { by: 'waycar', text: '2 Agents need you. api Claude is blocked. web Codex is done.' },
  { by: 'tap', text: 'web · Codex' },
  { by: 'waycar', text: 'web Codex is done: The checkout form uses the new API. What should I ask?' },
  { by: 'you', text: 'Did the tests pass?' },
  { by: 'waycar', text: 'All 42 pass. I left the old endpoint in place until you remove it.' },
];

const moments: { title: string; text: string; lines: ExchangeLine[] }[] = [
  {
    title: 'Allow or deny out loud',
    text: 'Claude Code and Codex approvals. Waycar reads the command and waits for your answer.',
    lines: [
      { by: 'waycar', text: 'api Claude is waiting on approval to run npm test. Allow or deny?' },
      { by: 'you', text: 'Allow.' },
      { by: 'waycar', text: 'Allowed.' },
    ],
  },
  {
    title: 'Say what to do instead',
    text: 'More than "deny". Waycar denies the command, then sends your words to the agent.',
    lines: [
      { by: 'you', text: 'Run only the unit tests.' },
      { by: 'waycar', text: 'Tell api Claude: Run only the unit tests. Send?' },
      { by: 'you', text: 'Send.' },
      { by: 'waycar', text: 'Denied. Sent your correction.' },
    ],
  },
  {
    title: 'Held until you stop',
    text: 'A force-push, a deploy, sudo, or anything too long to read out is never allowed from the car.',
    lines: [
      {
        by: 'waycar',
        text: "infra Claude wants to run git push --force origin main. This one looks risky: it force-pushes. I'll hold it until you're stopped.",
      },
      { by: 'tap', text: 'Hold' },
      { by: 'waycar', text: 'Holding it for later.' },
    ],
  },
];

const rows = [
  { name: 'Talk to Waycar', detail: 'a spoken briefing of what needs you' },
  { name: 'Need you', detail: 'Blocked, then Done', example: 'api · Claude', status: 'Blocked · 2m' },
  { name: 'Working', detail: 'with its progress, when there is an estimate', example: 'web · Codex', status: 'Working · 3/7 · 6m' },
  { name: 'Idle', detail: 'everything else; shells are not listed', example: 'infra · OMP', status: 'Idle · 1h' },
];

const details = [
  {
    title: 'Works with your iPhone locked',
    text: 'Leave it in your pocket. Everything happens on the car\'s screen and out loud.',
  },
  {
    title: 'Your Live Activity, in the car',
    text: "On the CarPlay Dashboard: the Host's name and lead count, then its top three agents.",
  },
  {
    title: 'Transcribed on your iPhone',
    text: 'Your voice becomes text on the iPhone, and only the text goes to your Host. Shell symbols are spoken as words, like "pipe", so you hear exactly what would run.',
  },
  {
    title: 'Pick the voice and speed',
    text: 'Waycar uses the best voice on your iPhone, or the one you pick, at 0.75× to 1.5×. Or try Natural Voice (Beta), a neural voice that runs on the iPhone.',
  },
];

const help = [
  { href: '/help/carplay', title: 'CarPlay', text: "What's on the car's screen, and how to ask an agent." },
  { href: '/help/carplay-voice', title: 'Approve commands by voice', text: 'Allow, deny, hold, and which approvals wait.' },
  { href: '/help/carplay-voice-not-working', title: "CarPlay voice isn't working", text: 'Microphone, voice and connection fixes.' },
];
---

<Layout
  title="Waycar in CarPlay: talk to your coding agents on the drive"
  description="Waycar in CarPlay lists the coding agents that need you and reads them out. Ask an agent, hear the answer, allow or deny an approval by voice. Nothing to read."
  image="/og-carplay.png"
  imageAlt="The headline 'Your agents, out loud. Nothing to read.' beside a spoken exchange: Waycar asks to allow npm test, you say Allow, Waycar says Allowed"
>
  <section class="section intro" aria-labelledby="carplay-title">
    <div class="wrap">
      <div class="top">
      <div class="sec-head">
        <span class="kicker">On the drive</span>
        <h1 id="carplay-title" class="sec-title">Your agents, out loud. <span class="muted">Nothing to read.</span></h1>
        <p class="sec-lede">
          Waycar in CarPlay tells you which coding agents need you. Ask one how it's going, or answer its approval, by
          voice. The car's screen shows only the list, and who you're talking to.
        </p>
        <div class="get">
          <AppStoreCta kind="button">Get Waycar</AppStoreCta>
          <span class="get-note">{ON_APP_STORE && <><span>Free on the App Store</span> · </>}<span>iPhone, iOS 26.4 or later</span></span>
        </div>
      </div>

      <figure class="photo">
        <Image
          src={voicePhoto}
          alt="A car's CarPlay display showing Waycar listening: the title 'Ask Waycar · 4' above a waveform, and nothing else"
          widths={[480, 720, 1080, 1440]}
          sizes="(min-width: 1080px) 560px, calc(100vw - 40px)"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>Asking an agent: its name, and a waveform while Waycar listens. On a real car's display, parked.</figcaption>
      </figure>
      </div>

      <div class="glass stage">
        <VoiceExchange lines={briefing} label="A drive with Waycar in CarPlay: the briefing, then a question to an agent" />
        <ul class="points">
          <li>
            <h3>Hear what needs you</h3>
            <p>Tap Talk to Waycar. When nothing is waiting, it says "Nothing needs you."</p>
          </li>
          <li>
            <h3>Ask, then hear back</h3>
            <p>Tap an agent and ask. When you pause, Waycar sends it, then speaks the answer in a sentence or two.</p>
          </li>
          <li>
            <h3>Keep the conversation going</h3>
            <p>It listens for your next question. Say "that's all" when you're done.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <div class="wrap"><div class="divider"></div></div>

  <section class="section" aria-labelledby="approve-title">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Approvals</span>
        <h2 id="approve-title" class="sec-title">Unblock it by voice. <span class="muted">Risky ones wait.</span></h2>
      </div>
      <ul class="moments">
        {
          moments.map((moment) => (
            <li class="glass moment">
              <h3>{moment.title}</h3>
              <p>{moment.text}</p>
              <VoiceExchange lines={moment.lines} label={moment.title} compact />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="wrap"><div class="divider"></div></div>

  <section class="section" aria-labelledby="screen-title">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">On the car's screen</span>
        <h2 id="screen-title" class="sec-title">A list. <span class="muted">That's all.</span></h2>
        <p class="sec-lede">
          The agents that need you sit on top, each with its status and how long ago it changed. A ring shows progress
          when an agent has an estimate. Nothing an agent writes is ever shown. You hear it instead.
        </p>
      </div>

      <div class="screen">
      <figure class="photo">
        <Image
          src={listPhoto}
          alt="A car's CarPlay display showing the Waycar list: 'Paperclip · vault' working, with a progress ring and 'wrapping up · now', then under Idle 'Waycar · 4', 'Paperclip · gh-email' and 'Paperclip · pclip-agent', each idle for 2 minutes"
          widths={[640, 960, 1400, 2048]}
          sizes="(min-width: 1248px) 720px, (min-width: 861px) 60vw, calc(100vw - 40px)"
          format="webp"
          quality={80}
        />
        <figcaption>One agent working, with its progress ring, then three idle. On a real car's display, parked.</figcaption>
      </figure>

      <ol class="rows" aria-label="What the list shows, top to bottom">
          {
            rows.map((row) => (
              <li>
                <p class="row-name">{row.name}</p>
                <p class="row-detail">{row.detail}</p>
                {row.example && (
                  <p class="row-example">
                    <span>{row.example}</span>
                    <span class="row-status">{row.status}</span>
                  </p>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <div class="wrap"><div class="divider"></div></div>

  <section class="section" aria-labelledby="details-title">
    <div class="wrap">
      <div class="sec-head">
        <span class="kicker">Good to know</span>
        <h2 id="details-title" class="sec-title">Phone in your pocket.</h2>
      </div>
      <ul class="details">
        {
          details.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>

      <div class="glass needs" aria-labelledby="needs-title">
        <div>
          <h3 id="needs-title">What you need</h3>
          <ul class="needs-list">
            <li>An iPhone on iOS 26.4 or later. iPad never connects to CarPlay.</li>
            <li>A car or head unit with CarPlay.</li>
            <li>Waycar, with a Host already set up at your desk.</li>
          </ul>
        </div>
        <div class="needs-cta">
          <AppStoreCta kind="button">Get Waycar</AppStoreCta>
          {ON_APP_STORE && <span class="get-note">Free on the App Store</span>}
        </div>
      </div>

      <h3 class="help-title">Help</h3>
      <ul class="help">
        {
          help.map((page) => (
            <li>
              <a class="glass card" href={page.href}>
                <span class="card-title">{page.title}</span>
                <span class="card-text">{page.text}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <p class="back">
        <a class="btn btn-ghost" href="/"><span aria-hidden="true">←</span> Back to the home page</a>
      </p>
    </div>
  </section>
</Layout>

<style>
  .intro::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 560px;
    background: radial-gradient(720px 320px at 75% 0%, rgb(var(--cyan-rgb) / 0.08), transparent 70%);
    pointer-events: none;
  }

  .intro {
    padding-top: clamp(48px, 7vw, 80px);
  }

  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 18px;
    margin-top: 28px;
  }

  .get-note {
    font: var(--fs-caption) var(--font-mono);
    color: var(--text-3);
  }

  .get-note span {
    white-space: nowrap;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 340px);
    justify-content: space-evenly;
    align-items: center;
    gap: 48px;
    padding: 48px 40px;
  }

  .points {
    display: grid;
    gap: 28px;
  }

  h3 {
    margin: 0 0 6px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .points p,
  .details p,
  .moment > p {
    max-width: 400px;
    font-size: 15px;
    color: var(--text-2);
  }

  /* ---------- Approvals ---------- */

  .moments {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .moment {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 6px;
    padding: 28px 24px;
  }

  .moment > :global(ol) {
    margin-top: 22px;
  }

  /* ---------- Photos of the car's screen ---------- */

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 560px);
    gap: 40px 56px;
    align-items: center;
    margin-bottom: 56px;
  }

  .top .sec-head {
    margin-bottom: 0;
  }

  .photo {
    margin: 0;
  }

  .photo :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-device);
  }

  .photo figcaption {
    margin-top: 12px;
    font: var(--fs-caption) / 1.6 var(--font-mono);
    color: var(--text-3);
  }

  /* ---------- The car's screen: the photo, then its rows in words ---------- */

  .screen {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    gap: 40px 56px;
    align-items: center;
  }

  .rows {
    display: grid;
    border-top: 1px solid var(--line);
    counter-reset: row;
  }

  .rows li {
    position: relative;
    display: grid;
    gap: 4px;
    padding: 16px 0 16px 36px;
    border-bottom: 1px solid var(--line);
    counter-increment: row;
  }

  .rows li::before {
    content: counter(row);
    position: absolute;
    top: 19px;
    left: 0;
    font: var(--fs-caption) / 1.6 var(--font-mono);
    color: var(--text-3);
  }

  .row-name {
    font-weight: 600;
    color: var(--text);
  }

  .row-detail {
    font-size: 15px;
    color: var(--text-2);
  }

  .row-example {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin-top: 4px;
    font: var(--fs-caption) / 1.6 var(--font-mono);
    color: var(--text-2);
  }

  .row-status {
    color: var(--text-3);
  }

  /* ---------- Good to know ---------- */

  .details {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
  }

  .needs {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 24px 40px;
    margin-top: 56px;
    padding: 28px 32px;
  }

  .needs-list {
    display: grid;
    gap: 6px;
    margin-top: 12px;
    color: var(--text-2);
  }

  .needs-list li {
    position: relative;
    padding-left: 18px;
  }

  .needs-list li::before {
    content: '';
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 6px;
    height: 6px;
    background: var(--grad);
    border-radius: 50%;
  }

  .needs-cta {
    display: grid;
    justify-items: center;
    gap: 10px;
  }

  .help-title {
    margin-top: 56px;
    margin-bottom: 16px;
  }

  .help {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .card {
    display: grid;
    gap: 4px;
    height: 100%;
    padding: 18px 20px;
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--line-2);
  }

  .card-title {
    font-weight: 600;
    color: var(--text);
  }

  .card-text {
    font-size: 14px;
    color: var(--text-2);
  }

  .back {
    margin-top: 56px;
  }

  @media (max-width: 1080px) {
    .moments {
      grid-template-columns: 1fr;
      max-width: 640px;
    }

    .details {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .top,
    .screen {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 860px) {
    .stage {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 28px 20px;
    }

    .help {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .details {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .needs {
      padding: 24px 20px;
    }

    .needs-cta {
      justify-items: start;
    }
  }
</style>
