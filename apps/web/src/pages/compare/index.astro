---
// /compare: every comparison, a card each, then one matrix of all of them
// against Waycar. The cards and the matrix come from the collection, so a new
// comparison joins both on its own.
import AppStoreCta from '../../components/AppStoreCta.astro';
import CompareLegend from '../../components/CompareLegend.astro';
import CompareMatrix from '../../components/CompareMatrix.astro';
import ComparisonLinks from '../../components/ComparisonLinks.astro';
import Layout from '../../layouts/Layout.astro';
import { formatReleaseDate } from '../../lib/changelog.mjs';
import { comparePath, getComparisons } from '../../lib/compare';
import { KIND_LABELS, type CapabilityId, type Level } from '../../lib/compare-rows.mjs';

const comparisons = await getComparisons();
// Every comparison was checked on its own day; the matrix is as fresh as the oldest.
const oldestCheck = comparisons.map((entry) => entry.data.checked).sort()[0];

// The "not the right pick" list names products from their rows, so it cannot
// drift from the table. The comparisons that rate `id` as one of `levels`:
const rated = (id: CapabilityId, ...levels: Level[]) => comparisons.filter((entry) => levels.includes(entry.data.rows[id].level));
const generalSsh = rated('general-ssh', 'yes');
const desktopOrWeb = rated('desktop', 'yes');
const android = rated('android', 'yes', 'partial');
// The one hand-written pick: it must name a page that exists.
const remoteControl = comparisons.find((entry) => entry.id === 'claude-code-remote-control');
if (!remoteControl) throw new Error('src/pages/compare/index.astro names the claude-code-remote-control comparison, which is missing');
// A pick built from the rows must not print an empty list if the rows change.
for (const [pick, list] of Object.entries({ generalSsh, desktopOrWeb, android })) {
  if (list.length === 0) throw new Error(`src/pages/compare/index.astro: no comparison qualifies for the "${pick}" pick`);
}
---

<Layout
  title="Compare Waycar with Termius, Blink Shell and more"
  description="Sourced comparisons of Waycar with Termius, Blink Shell, Claude Code Remote Control, Happy and more, for reaching coding agents from a phone."
  markdown="/compare.md"
>
  <section class="section compare-index" aria-labelledby="compare-title">
    <div class="wrap">
      <header class="head">
        <span class="kicker">Compare</span>
        <h1 id="compare-title" class="sec-title">How Waycar compares</h1>
        <p class="sec-lede">
          Waycar is an iPhone and iPad app for checking on coding agents that run in herdr, tmux, Herdr Core or Zellij, or as Codex and
          OpenCode chats, on your own machines.
          Each page below sets it beside another way to reach an agent from a phone. It says where Waycar fits better, where
          the other tool does, and which sources we checked.
        </p>
      </header>

      <ul class="cards">
        {
          comparisons.map((entry) => (
            <li>
              <a class="glass card" href={comparePath(entry.id)}>
                <span class="card-kind">{KIND_LABELS[entry.data.kind]}</span>
                <h2 class="card-title">{entry.data.title}</h2>
                <span class="card-text">{entry.data.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <section class="glance" aria-labelledby="glance-title">
        <h2 id="glance-title">At a glance</h2>
        <CompareMatrix comparisons={comparisons} />
        <CompareLegend>Facts checked {formatReleaseDate(oldestCheck)} or later; each page lists its sources.</CompareLegend>
      </section>

      <section class="fit" aria-labelledby="fit-title">
        <h2 id="fit-title">When Waycar is not the right pick</h2>
        <ul>
          <li>You want a general SSH client with SFTP and port forwarding, for any server. Waycar needs herdr, tmux or Herdr Core on the machine (Zellij, Codex and OpenCode 2 from the next update). Try <ComparisonLinks entries={generalSsh} join="or" />.</li>
          <li>You want a desktop or web client beside the phone app, or an Android app today. Waycar is an iPhone and iPad app with no native desktop or web client, and an Android app is coming soon. With a desktop or web client: <ComparisonLinks entries={desktopOrWeb} join="and" />. With an Android app: <ComparisonLinks entries={android} join="and" />.</li>
          <li>You only use Claude Code and already pay for a Claude plan. <a href={comparePath(remoteControl.id)}>Remote Control</a> is built in and needs no SSH setup.</li>
          <li>You need agents to keep working with your computer off. Waycar reaches your own machine, so that machine has to be on and awake.</li>
        </ul>
      </section>

      <section class="glass closing" aria-labelledby="closing-title">
        <h2 id="closing-title">Try Waycar on your own machine</h2>
        <div class="actions">
          <AppStoreCta kind="button">Get Waycar</AppStoreCta>
          <a class="btn btn-ghost btn-lg" href="/solutions">See how people use it</a>
        </div>
      </section>
    </div>
  </section>
</Layout>

<style>
  .compare-index {
    padding-top: 64px;
  }

  .head {
    max-width: 820px;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    max-width: 960px;
    margin-top: 48px;
  }

  .card {
    display: grid;
    gap: 6px;
    align-content: start;
    height: 100%;
    padding: 20px 22px;
    border-radius: var(--radius-control-lg);
  }

  .card:hover {
    border-color: var(--line-2);
  }

  .card-kind {
    font: var(--fw-label) var(--fs-label) / 1.4 var(--font-mono);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--violet-soft);
  }

  .card-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .card-text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-3);
  }

  .glance,
  .fit {
    margin-top: 72px;
  }

  h2 {
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .glance :global(.scroll) {
    margin-top: 20px;
  }

  .glance :global(.legend) {
    margin-top: 16px;
  }

  .fit ul {
    display: grid;
    gap: 14px;
    max-width: 72ch;
    margin-top: 20px;
    padding-left: 22px;
    list-style: disc;
    color: var(--text-2);
  }

  .fit li::marker {
    color: var(--violet-soft);
  }

  .fit a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .closing {
    max-width: 960px;
    margin-top: 72px;
    padding: 28px 28px 30px;
  }

  .closing h2 {
    font-size: 24px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  @media (max-width: 720px) {
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
