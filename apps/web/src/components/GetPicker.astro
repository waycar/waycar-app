---
// The "Get Waycar" picker: every store button starts here. With JavaScript,
// iPhone, iPad (including desktop mode) and iPod touch visitors instead get a
// direct App Store link, sending `app_store_clicked`. Everyone else opens the
// picker and sends `get_picker_opened`; its App Store badge sends
// `app_store_clicked`. Without JavaScript the picker still opens, with no events.
// One picker per button (`AppStoreCta` renders the pair) keeps that button's
// `ct` (or a paid campaign's) and wrapper's `module`.
// Copy and claim limits: the `picker-copy` document on WAY-312.
//
// One tile, "iPhone and iPad", with Apple's badge, then the quiet "Open
// source on GitHub" link (`SourceLink`) and Close.
//
// Wide screens with a mouse always show the QR code under the badge, no second
// click (`/qr/site-qr.svg`, made at build time); elsewhere it stays hidden.
// The QR carries its own `ct`, `site-qr`, for getting the app onto a phone.
//
// With JavaScript outside Apple handhelds, the button opens a modal `<dialog>`:
// Esc, focus trap, inert page and focus return come from the browser.
// Without it the button is a link to this element's id, and `:target` shows
// the same box as a fixed overlay. Close and the backdrop are links to `#_`,
// a fragment nothing matches, so the page does not jump. A `<form
// method="dialog">` would not work here: the CSP has `form-action 'none'`.
import SourceLink from './SourceLink.astro';

interface Props {
  /** Unique on the page; the button links to `#<id>`. */
  id: string;
  /** The App Store listing, tagged with the opening button's `ct`. */
  href: string;
}

const { id, href } = Astro.props;
---

<dialog class="picker" id={id} aria-labelledby={`${id}-title`}>
  <a class="backdrop" href="#_" tabindex="-1" aria-hidden="true" data-picker-close></a>
  <div class="card">
    <h2 id={`${id}-title`} class="title">Get Waycar</h2>
    <div class="tile">
      <p class="platform">iPhone and iPad</p>
      <a
        class="store"
        href={href}
        aria-label="Download on the App Store for iPhone and iPad"
        data-ph-event="app_store_clicked"
        autofocus
      >
        <img src="/app-store-badge.svg" alt="" width="150" height="50" loading="lazy" decoding="async" />
      </a>
      <figure class="qr">
        <img src="/qr/site-qr.svg" alt="" width="148" height="148" loading="lazy" decoding="async" />
        <figcaption>Scan with your iPhone or iPad</figcaption>
      </figure>
    </div>
    <p class="source"><SourceLink /></p>
    <a class="btn btn-ghost close" href="#_" data-picker-close>Close</a>
  </div>
</dialog>

<style>
  /* The dialog is the whole viewport and the card sits in its middle, so the
     backdrop link covers everything around the card. */
  .picker {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    color: var(--text);
    background: transparent;
    border: 0;
  }

  .picker::backdrop {
    background: transparent;
  }

  .picker[open] {
    display: grid;
    place-items: center;
  }

  /* No JavaScript: the link to the picker's id puts it in :target, and CSS
     shows it where the browser's own `display: none` would hide it. */
  @media (scripting: none) {
    .picker:target {
      display: grid;
      place-items: center;
    }
  }

  /* The page behind does not scroll. The stable gutter keeps the page where it
     is when a classic scrollbar goes away. */
  :global(html:has(dialog.picker[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  @media (scripting: none) {
    :global(html:has(dialog.picker:target)) {
      overflow: hidden;
      scrollbar-gutter: stable;
    }
  }

  .backdrop {
    position: absolute;
    inset: 0;
    background: rgb(var(--black-rgb) / 0.72);
    cursor: default;
  }

  .card {
    position: relative;
    box-sizing: border-box;
    width: min(400px, calc(100% - 32px));
    max-height: calc(100% - 32px);
    padding: 24px;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--panel);
    border: 1px solid var(--line-2);
    text-align: left;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-window);
  }

  @media (prefers-reduced-motion: no-preference) {
    .picker[open] .card {
      animation: picker-in 0.16s ease-out;
    }

    @keyframes picker-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
    }
  }

  .title {
    margin: 0 0 16px;
    text-align: center;
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  /* The one tile, centered under the centered title. */
  .tile {
    display: grid;
    align-content: start;
    gap: 10px;
    justify-items: center;
    padding: 16px;
    text-align: center;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-card);
  }

  .platform {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  /* Apple's badge rules: at least 40 px tall, clear space of a quarter of its
     height. The link is the badge plus that clear space. */
  .store {
    display: inline-block;
    padding: 6px 0;
    border-radius: var(--radius-control);
  }

  .store img {
    display: block;
    width: auto;
    height: 50px;
  }

  /* A computer visitor scans this with a phone, so the QR shows only with a
     mouse on a wide screen, never on a phone or tablet held in the hand. The
     SVG carries its own white ground and quiet zone. */
  .qr {
    display: none;
    gap: 8px;
    justify-items: center;
    margin: 0;
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 820px) {
    .qr {
      display: grid;
    }
  }

  .qr img {
    display: block;
    width: 148px;
    height: 148px;
    border-radius: 8px;
  }

  .qr figcaption {
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-2);
  }

  .source {
    margin: 12px 0 0;
    text-align: center;
  }

  .close {
    display: flex;
    margin-top: 12px;
    cursor: pointer;
  }
</style>

<script>
  import { isAppleHandheld } from '../lib/ad-links.mjs';

  // Copy the button's own picker link, keeping its organic or paid `ct`.
  // If Layout's campaign rewrite runs later, it also finds these direct links.
  if (isAppleHandheld(navigator)) {
    document.querySelectorAll<HTMLAnchorElement>('a[data-picker-open]').forEach((button) => {
      const storeLink = document.getElementById(button.hash.slice(1))?.querySelector<HTMLAnchorElement>('a.store');
      if (!storeLink) return;
      button.href = storeLink.href;
      button.dataset.phEvent = 'app_store_clicked';
      button.removeAttribute('data-picker-open');
      button.removeAttribute('aria-haspopup');
    });
  }

  // Opens a remaining button's picker as a modal dialog and closes it again.
  // Bundled by Astro as an external module (no inline script under the CSP).
  // Without this script the buttons are plain links to `#<id>` and the CSS
  // above shows the target. The browser handles Esc and the focus trap; the
  // backdrop and Close links are handled here so they do not leave a `#_` in
  // the URL.
  let opener: HTMLElement | null = null;
  let scrollTop = 0;

  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target || event.defaultPrevented || event.button !== 0) return;
    if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

    const button = target.closest<HTMLAnchorElement>('[data-picker-open]');
    if (button) {
      const dialog = document.getElementById(button.hash.slice(1));
      if (dialog instanceof HTMLDialogElement && !dialog.open) {
        event.preventDefault();
        opener = button;
        scrollTop = window.scrollY;
        dialog.showModal();
      }
      return;
    }

    const closer = target.closest('[data-picker-close]');
    const dialog = closer?.closest('dialog');
    if (closer && dialog) {
      event.preventDefault();
      dialog.close();
    }
  });

  // Safari does not focus a link on click, so the browser's own "return focus
  // to the opener" has nothing to return to. `close` does not bubble. The page
  // behind is locked with `overflow: hidden` (see the style), which on a
  // browser with classic scrollbars resizes viewport-width type by a hair, so
  // the scroll position goes back to exactly where the visitor was. (`instant`:
  // the site's smooth scrolling would animate it.)
  document.addEventListener(
    'close',
    (event) => {
      if (event.target instanceof HTMLDialogElement && event.target.classList.contains('picker')) {
        window.scrollTo({ top: scrollTop, behavior: 'instant' });
        opener?.focus({ preventScroll: true });
        opener = null;
      }
    },
    true,
  );
</script>
