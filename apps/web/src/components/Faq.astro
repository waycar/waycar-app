---
import { ON_APP_STORE } from '../data/links';
import QaList from './QaList.astro';

interface Props {
  extra?: { q: string; a: string; cmd?: string }[];
}

const { extra = [] } = Astro.props;

// The page keeps the questions people ask before downloading; all 19, with full
// answers, live in src/llms/index.md.
const questions = [
  {
    q: 'How do I get Waycar?',
    a: ON_APP_STORE
      ? 'Download it on the App Store, then run the install command on each machine, or add one by hand.'
      : "It's coming soon to the App Store. Then run the install command on each machine, or add one by hand.",
  },
  {
    q: 'Can I try it before I set up a machine?',
    a: 'Yes. Before you add a machine, the first screen offers a Sample: example Blocked, Done and Working agents you can browse offline. It goes away when you add a Host.',
  },
  {
    q: 'Do I need herdr?',
    a: 'No. tmux 3.2 or later works too, and so does Herdr Core. Zellij, Codex and OpenCode 2 come in the next update.',
  },
  {
    q: 'What does the install command change on my machine?',
    a: 'It unpacks the Waycar host tools to ~/.local/share/waycar/plugin after checking their SHA-256 checksum. With herdr it links a plugin. With tmux it adds status hooks to the agents it finds and keeps your own. Pairing adds one line to ~/.ssh/authorized_keys. No sudo, no system service, no open port.',
    link: { href: '/help/install#what-does-it-install', label: 'What it installs' },
  },
  {
    q: 'Does anything go through the cloud?',
    a: 'Not your sessions: they go over SSH straight to your machine. Push notifications and usage analytics are optional. AI Summaries, if you turn them on, send recent screen text to your AI provider.',
  },
  {
    q: "My machine isn't reachable from the internet. Can I still use it?",
    a: 'Yes. Put your phone and your machine on the same VPN, such as Tailscale, or put an SSH Jump Host in front of it. Waycar only needs SSH to reach it.',
    link: { href: '/help/away-from-home', label: 'Use Waycar away from home' },
  },
  {
    q: 'Is Waycar open source?',
    a: 'Yes. The app, the host tools and the push relay are on GitHub under the Apache-2.0 license.',
    link: { href: 'https://github.com/waycar/waycar-app', label: 'waycar/waycar-app on GitHub' },
  },
  {
    q: 'Which agents work in Chat Mode?',
    a: 'Claude Code, Codex, omp, pi, opencode, GitHub Copilot CLI, Qwen Code, Gemini CLI, Grok Build, Antigravity, Hermes Agent, Kilo Code, Cline and Muse. Run the install command again first. On herdr, Antigravity also needs',
    cmd: 'herdr integration install antigravity-cli',
  },
  {
    q: 'Is Waycar affiliated with herdr or the AI companies?',
    a: 'No. Waycar is an independent app from OTREVA, LLC.',
  },
];
---

<section id="faq" class="section" aria-labelledby="faq-title">
  <div class="wrap layout">
    <div class="sec-head">
      <span class="kicker">FAQ</span>
      <h2 id="faq-title" class="sec-title">Before you ask.</h2>
    </div>
    <QaList items={[...questions, ...extra]} />
  </div>
</section>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .sec-head {
      margin-bottom: 0;
    }
  }
</style>
