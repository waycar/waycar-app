---
// A list of questions and answers in glass rows: the home page FAQ and the
// pricing page. `cmd`, when set, follows the answer as inline code.
interface Props {
  items: { q: string; a: string; cmd?: string }[];
}

const { items } = Astro.props;
---

<dl class="list">
  {
    items.map((item) => (
      <div class="glass row">
        <dt>{item.q}</dt>
        <dd>
          {item.a}
          {item.cmd && (
            <>
              {' '}
              <code>{item.cmd}</code>.
            </>
          )}
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .list {
    display: grid;
    gap: 12px;
  }

  .row {
    padding: 22px 24px;
  }

  dt {
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
  }

  dd {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-2);
  }

  dd code {
    padding: 1px 6px;
    font-size: 0.86em;
    color: var(--text);
    background: rgb(var(--white-rgb) / 0.06);
    border-radius: var(--radius-code);
  }
</style>
