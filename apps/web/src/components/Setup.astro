---
import { ON_APP_STORE } from '../data/links';
import { runtimes } from '../data/supported';
import AppStoreCta from './AppStoreCta.astro';
import CodeBlock from './CodeBlock.astro';
import SourceLink from './SourceLink.astro';

const installCmd = 'curl -fsSL https://waycar.dev/install.sh | sh';

const atLeast = ({ name, min }: { name: string; min: string }) => `${name} ≥ ${min}`;
const live = runtimes.filter((runtime) => !runtime.next);
const next = runtimes.filter((runtime) => runtime.next);

const requirements = [
  'iOS / iPadOS 18+',
  ...live.map((runtime, index) => (index ? `or ${atLeast(runtime)}` : atLeast(runtime))),
  ...(next.length ? [`Next update: ${next.map(atLeast).join(', ')}`] : []),
  'No Node needed on the Host',
  'OpenSSH · streamlocal on, for herdr',
  'macOS: Remote Login on',
  'mosh-server + UDP, for mosh',
];
---

<section id="setup" class="section" aria-labelledby="setup-title">
  <div class="wrap setup-grid">
    <div>
      <span class="kicker">Setup</span>
      <h2 id="setup-title" class="sec-title">Get the app. Run one command. <span class="muted">Scan.</span></h2>
      <ol class="steps">
        <li>
          <div>
            <h3>Get Waycar</h3>
            <div class="line">
              <AppStoreCta kind="button" ct="site-closing">Get Waycar</AppStoreCta>
              {ON_APP_STORE && <span class="cta-note">Free on the App Store</span>}
              <SourceLink />
            </div>
          </div>
        </li>
        <li>
          <div>
            <h3>Install on your Mac or Linux box</h3>
            <p>Works with herdr, tmux, Herdr Core, or more than one.</p>
          </div>
        </li>
        <li>
          <div>
            <h3>Scan the code</h3>
            <p>Say yes to show a QR, then scan it in Waycar. Run it again to pair another device.</p>
          </div>
        </li>
      </ol>
      <ul class="reqs" aria-label="Requirements">
        {requirements.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="term-col" data-ph-copy-event="install_command_copied">
      <CodeBlock
        title="you@studio-mac — zsh"
        label="Command to install Waycar for herdr or tmux"
        copy={installCmd}
        lines={[
          { kind: 'cmd', text: installCmd, arg: 'https://waycar.dev/install.sh' },
          { kind: 'comment', text: '# answer Y to show a pairing QR' },
        ]}
      />
      <div class="command-facts">
        <h3>What the command does</h3>
        <ul>
          <li>Downloads the Waycar host tools, checks their SHA-256 checksum, and unpacks them to <code>~/.local/share/waycar/plugin</code>.</li>
          <li>With herdr, links the Waycar plugin. With tmux 3.2 or later, adds status hooks to the agents it finds and keeps your own hooks.</li>
          <li>Pairing adds one line for your phone's key to <code>~/.ssh/authorized_keys</code>.</li>
          <li>No sudo, no system service, no open port.</li>
          <li>Not allowed to install software there? Add <code>--pair-only</code>: it pairs and installs nothing.</li>
        </ul>
        <div class="command-links">
          <a href="https://github.com/waycar/waycar-app/blob/main/plugin/install.sh">Read the script</a>
          <a href="/help/install#what-does-it-install">What it installs</a>
          <a href="/help/remove-host-tools">Remove it</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .setup-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 56px;
    align-items: center;
  }

  .steps {
    display: grid;
    gap: 22px;
    margin-top: 36px;
    counter-reset: s;
  }

  .steps li {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 16px;
    counter-increment: s;
  }

  .steps li::before {
    content: counter(s);
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    font: 600 13px var(--font-mono);
    color: var(--text);
    background: rgb(var(--white-rgb) / 0.03);
    border: 1px solid var(--line-2);
    border-radius: 10px;
  }

  h3 {
    margin-top: 6px;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .steps p,
  .steps .line {
    margin-top: 4px;
    font-size: 14.5px;
    color: var(--text-2);
  }

  .steps .line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .command-facts {
    margin-top: 32px;
    font-size: var(--fs-button);
    line-height: var(--lh-body);
    color: var(--text-2);
  }

  .command-facts h3 {
    color: var(--text);
  }

  .command-facts ul {
    display: grid;
    gap: 12px;
    margin-top: 16px;
    padding-left: 20px;
    list-style: disc;
  }

  .command-facts code {
    font-size: var(--fs-code);
    white-space: nowrap;
  }

  .command-links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 20px;
  }

  .command-links a {
    color: var(--cyan);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .reqs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 32px;
  }

  .reqs li {
    padding: 5px 10px;
    font: 12px var(--font-mono);
    color: var(--text-2);
    background: rgb(var(--white-rgb) / 0.02);
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .term-col {
    min-width: 0;
  }

  @media (max-width: 1080px) {
    .setup-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
