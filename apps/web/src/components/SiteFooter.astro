---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { ON_APP_STORE } from '../data/links';
import AppStoreCta from './AppStoreCta.astro';
import SourceLink from './SourceLink.astro';
import { comparePath, getComparisons } from '../lib/compare';
import { getSolutions, solutionPath } from '../lib/solutions';

// Pages only, as in the header. The header's links stay here too: on a phone
// the header shows none of them.
const more = [
  { href: '/carplay', label: 'CarPlay' },
  { href: '/help', label: 'Help' },
  { href: '/articles', label: 'Articles' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/support', label: 'Support' },
];

/** The entries `ids` names, in that order; a renamed or removed page fails the build. */
function picked<T extends { id: string }>(entries: T[], ids: string[]): T[] {
  return ids.map((id) => {
    const entry = entries.find((item) => item.id === id);
    if (!entry) throw new Error(`SiteFooter: no page "${id}"`);
    return entry;
  });
}

// A few pages, then the index with every page. Picked by PostHog page views
// (30 days to 2026-11-14, a handful each), plus Termius, the best-known name.
const compare = [
  ...picked(await getComparisons(), ['claude-code-remote-control', 'blink-shell', 'termius']).map((entry) => ({
    href: comparePath(entry.id),
    label: entry.data.name,
  })),
  { href: '/compare', label: 'All comparisons' },
];
const solutions = [
  ...picked(await getSolutions(), ['check-ai-agent-remotely', 'mosh-client-ios']).map((entry) => ({
    href: solutionPath(entry.id),
    label: entry.data.title,
  })),
  { href: '/solutions', label: 'All solutions' },
];

const eula = 'https://www.apple.com/legal/internet-services/itunes/dev/stdeula/';
---

<footer class="footer">
  <div class="wrap">
    <div class="foot">
      <div>
        <p class="brand">
          <Image class="mark" src={logo} alt="" width={24} height={24} densities={[1, 2, 3]} />
          Waycar
        </p>
        <p class="blurb">Your agents in herdr, tmux, Herdr Core and Zellij, plus Codex and OpenCode chats, on iPhone and iPad. Over mosh and SSH, with no cloud between you and your sessions.</p>
      </div>
      <nav aria-labelledby="foot-compare">
        <h2 id="foot-compare">Compare</h2>
        <ul>{compare.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="foot-solutions">
        <h2 id="foot-solutions">Solutions</h2>
        <ul>{solutions.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="foot-more">
        <h2 id="foot-more">More</h2>
        <ul>{more.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
      </nav>
    </div>
    <div class="foot-bottom">
      <span class="get">
        {
          ON_APP_STORE ? (
            <AppStoreCta kind="text" ct="site-nav" class="store">Get Waycar</AppStoreCta>
          ) : (
            <span>Coming soon to the App Store for iPhone &amp; iPad</span>
          )
        }
        <SourceLink />
      </span>
      {/* Apple's trademark credit and the third-party notices are on /privacy. */}
      <nav class="legal" aria-label="Legal">
        <a href={eula}>Terms</a>
        <a href="/privacy">Privacy</a>
        {/* Unhidden by the Layout script (needs JavaScript). */}
        <button type="button" class="consent-open" data-consent-open hidden>Cookie settings</button>
      </nav>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: 48px 0 56px;
    font-size: 14px;
    color: var(--text-3);
    border-top: 1px solid var(--line);
  }

  .foot {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: 32px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
  }

  .brand :global(.mark) {
    border-radius: 6px;
  }

  .blurb {
    max-width: 380px;
    color: var(--text-2);
  }

  h2 {
    margin-bottom: 14px;
    font: 500 11.5px var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-2);
  }

  ul {
    display: grid;
    gap: 4px;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--text-2);
  }

  a:hover,
  .consent-open:hover {
    color: var(--text);
  }

  .consent-open {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: 0;
    font: inherit;
    color: var(--text-2);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .consent-open[hidden] {
    display: none;
  }

  .foot-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: 40px;
    padding-top: 24px;
    font: var(--fs-caption) / 1.6 var(--font-mono);
    border-top: 1px solid var(--line);
  }

  .foot-bottom .get,
  .foot-bottom .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 16px;
  }

  @media (max-width: 860px) {
    .foot {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }

    .foot > div:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
