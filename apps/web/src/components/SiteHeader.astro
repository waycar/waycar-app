---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { SOURCE_URL } from '../data/supported';
import AppStoreCta from './AppStoreCta.astro';
import HelpSearch from './HelpSearch.astro';

// Pages only: no link that just scrolls to a home page section.
const links = [
  { href: '/', label: 'Product' },
  { href: '/carplay', label: 'CarPlay' },
  { href: '/help', label: 'Help' },
  { href: '/articles', label: 'Articles' },
];
---

<header class="nav">
  <div class="wrap bar">
    <a class="brand" href="/">
      <Image class="mark" src={logo} alt="" width={28} height={28} densities={[1, 2, 3]} loading="eager" />
      <span>Waycar</span>
    </a>
    <nav class="links" aria-label="Primary">
      <ul>
        {
          links.map((link) => (
            <li>
              <a class="link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="right">
      <HelpSearch />
      {/* Plain text beside the button, so Download stays the one thing to press. */}
      <a class="link" href={SOURCE_URL} data-ph-event="github_clicked">GitHub</a>
      <AppStoreCta kind="header" ct="site-nav" />
    </div>
  </div>
</header>

<style>
  /* The frosted ground is a pseudo-element, not the header's own
     `backdrop-filter`: a filter on the header would make it the containing
     block of the Get Waycar picker's fixed overlay when JavaScript is off,
     and the overlay would shrink to the header's box. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
  }

  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(var(--bg-rgb) / 0.72);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 32px;
    height: var(--header-h);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .brand :global(.mark) {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    box-shadow: 0 0 0 1px var(--line-2);
  }

  .links ul {
    display: flex;
    gap: 4px;
  }

  .link {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 10px;
    font-size: var(--fs-button);
    color: var(--text-2);
    white-space: nowrap;
    border-radius: var(--radius-keycap);
  }

  .link:hover {
    color: var(--text);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-left: auto;
  }

  /* Where the link row stops fitting beside the brand and the right side. */
  @media (max-width: 799px) {
    .links {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .bar {
      gap: 12px;
    }

    .right .link {
      padding: 0 6px;
    }
  }

  /* Narrower than any iPhone Waycar runs on: the mark alone names the brand,
     so GitHub still fits beside Download. Screen readers keep the name. */
  @media (max-width: 359px) {
    .brand span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
