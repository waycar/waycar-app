---
import { ON_APP_STORE } from '../../data/links';
import AppStoreCta from '../AppStoreCta.astro';
---

<section class="section final" aria-labelledby="final-title">
  <div class="wrap">
    <h2 id="final-title" class="sec-title">Get up from your desk.<br /><span class="grad-text">Your agents keep building.</span></h2>
    <div class="ctas">
      <AppStoreCta kind="button" ct="site-closing">Get Waycar</AppStoreCta>
      <a class="btn btn-ghost btn-lg" href="#setup">Set up your computer →</a>
    </div>
    {ON_APP_STORE && <p class="note"><span class="cta-note">Free on the App Store · iOS 18 or later</span></p>}
  </div>
</section>

<style>
  /* Copied from page A's Closing.astro on purpose, so edits to B never change A during the A/B test. When the test ends, delete the losing version. */
  .final {
    overflow: hidden;
    padding-block: clamp(100px, 13vw, 140px) clamp(90px, 11vw, 120px);
    text-align: center;
  }

  .final::before {
    content: '';
    position: absolute;
    top: 40%;
    left: 50%;
    z-index: -1;
    width: min(760px, 100%);
    height: 420px;
    background: radial-gradient(closest-side, rgb(var(--violet-rgb) / 0.28), rgb(var(--cyan-rgb) / 0.08) 60%, transparent);
    filter: blur(30px);
    transform: translate(-50%, -50%);
  }

  .sec-title {
    font-size: clamp(38px, 5.4vw, 64px);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .note {
    margin-top: 16px;
  }

  @media (max-width: 560px) {
    .ctas > * {
      flex: 1 1 100%;
    }
  }
</style>
