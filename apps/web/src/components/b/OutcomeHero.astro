---
import { getImage } from 'astro:assets';
import { dictationHero } from '../../data/screens';
import AppStoreCta from '../AppStoreCta.astro';
import CodeBlock from '../CodeBlock.astro';

const featured = ['claude', 'codex', 'omp', 'gemini', 'opencode', 'pi'];
const proof = ['agents run on your own computer', 'on-device dictation (iOS 26+)', 'a push when an agent is blocked', 'no account'];
const installCmd = 'curl -fsSL https://waycar.dev/install.sh | sh';

const { still } = dictationHero;
const stillSet = await getImage({ src: still, widths: [660, still.width], format: 'webp', quality: 82 });
// The image's drawn width: the stage column of the 1200px-capped grid, minus the bezel.
const heroSizes = '(min-width: 1024px) min(489px, calc(45vw - 73px)), (min-width: 648px) 576px, calc(100vw - 52px)';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="text">
    <p class="eyebrow">
      <span class="tag">NEW</span>Native for iPhone &amp; iPad<span class="long"> · works with herdr and tmux · Android coming soon</span>
    </p>
    <h1 id="hero-title">
      Step away.<br class="br-d" /> Keep talking.<br />
      <span class="grad-text">Pick right up.</span>
    </h1>
    <p class="lede">
      Talk to your phone and the agents on your own Mac or Linux box keep building, with the same harness, models and files you use at your desk. Sit back down later and it's all there.
    </p>
    </div>

    <div class="stage">
      <div class="closeup">
        <div class="bezel">
          <picture>
            <source media="(prefers-reduced-motion: reduce)" type="image/webp" srcset={stillSet.srcSet.attribute} sizes={heroSizes} />
            <img
              src={dictationHero.anim}
              srcset={`${dictationHero.anim660} 660w, ${dictationHero.anim} ${still.width}w`}
              sizes={heroSizes}
              width={still.width}
              height={still.height}
              alt={dictationHero.alt}
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>
      </div>
      <p class="callout c1" aria-hidden="true"><span class="pill pill-blocked">Blocked</span> your agent has a question</p>
      <p class="callout c2" aria-hidden="true"><span class="pill pill-mosh">MIC</span> answer out loud, then check it and send</p>
    </div>

    <div class="cta">
    <div class="cta-row">
    <div class="ctas">
      <AppStoreCta kind="hero" ct="site-hero-b" />
    </div>
    <div class="install" data-ph-copy-event="install_command_copied">
      <p class="install-label">Then run this on your Mac or Linux box:</p>
      <CodeBlock
        title="install Waycar on your Host"
        label="Command to install Waycar for herdr or tmux"
        copy={installCmd}
        lines={[{ kind: 'cmd', text: installCmd, arg: 'https://waycar.dev/install.sh' }]}
      />
    </div>
    </div>
    </div>

    <div class="meta">
    <ul class="proof" aria-label="What you get">
      {proof.map((item) => <li>{item}</li>)}
    </ul>
    <p class="agents-row">
      <span>works with</span>
      {featured.map((cli) => <code class="k">{cli}</code>)}
      <span>+ more</span>
    </p>
    </div>
  </div>
</section>

<style>
  /* Copied from page A's Hero.astro on purpose, so edits to B never change A during the A/B test. When the test ends, delete the losing version. The stage below is B's own (a single iPhone close-up), not A's. */
  .hero {
    position: relative;
    isolation: isolate;
    padding: 64px 0 40px;
    text-align: center;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(var(--white-rgb) / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--white-rgb) / 0.055) 1px, transparent 1px);
    background-position: center top;
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 20%, var(--black) 10%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 55% at 50% 20%, var(--black) 10%, transparent 75%);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px 7px 8px;
    font: 500 12.5px / 1 var(--font-mono);
    color: var(--text-2);
    background: rgb(var(--white-rgb) / 0.035);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
  }

  .tag {
    padding: 4px 8px;
    font-weight: 600;
    color: var(--ink);
    background: var(--grad);
    border-radius: var(--radius-pill);
  }

  h1 {
    max-width: 960px;
    margin: 28px auto 22px;
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: transparent;
    background: var(--grad-title);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .lede {
    max-width: 640px;
    margin: 0 auto;
    font-size: var(--fs-lede);
    color: var(--text-2);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin-top: 24px;
    font: 13px var(--font-mono);
    color: var(--text-2);
  }

  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .proof li::before {
    content: '✓';
    color: var(--cyan);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
  }

  .install {
    width: min(560px, 100%);
    margin: 28px auto 0;
    text-align: left;
  }

  .install-label {
    margin-bottom: 10px;
    font: 13px var(--font-mono);
    color: var(--text-2);
    text-align: center;
  }

  .br-d {
    display: none;
  }

  @media (min-width: 1024px) {
    .hero {
      padding: 56px 0 40px;
      text-align: left;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      /* Below 1024px the blocks stack in DOM order: text, stage, cta, meta, so
         phones see the close-up before the CTAs (the header keeps the App
         Store CTA on screen). */
      grid-template-areas: 'text stage' 'cta stage' 'meta stage';
      grid-template-rows: auto auto 1fr;
      column-gap: 56px;
      align-items: start;
    }

    .text {
      grid-area: text;
    }

    .cta {
      grid-area: cta;
    }

    .meta {
      grid-area: meta;
    }

    .br-d {
      display: inline;
    }

    h1 {
      margin: 24px 0 20px;
      font-size: clamp(52px, 5.2vw, 76px);
    }

    .lede {
      margin: 0;
    }

    /* `.meta` raises specificity over the base centered rules later in the file. */
    .meta .proof,
    .meta .agents-row {
      justify-content: flex-start;
    }

    .meta .agents-row {
      margin-top: 18px;
    }

    .cta-row {
      display: flex;
      justify-content: flex-start;
      align-items: center;
      gap: 20px;
      margin-top: 28px;
    }

    /* Offset by the install label so the badge centers on the code window. */
    .cta-row .ctas {
      flex: none;
      justify-content: flex-start;
      margin: 0 0 0 -12px;
      padding-top: 30px;
    }

    .cta-row .install {
      flex: 1 1 auto;
      min-width: 0;
      max-width: 460px;
      margin: 0;
    }

    .cta-row .install-label {
      text-align: left;
    }

    /* The left column is narrower than A's centered row, so the command uses
       the phone code size (global.css, 560px and below) and may wrap at spaces
       instead of running under the copy button. */
    .cta-row .install :global(.window pre) {
      font-size: 12px;
      white-space: pre-wrap;
    }

    .hero .stage {
      grid-area: stage;
      align-self: center;
      width: 100%;
      max-width: 560px;
      margin: 0 auto;
    }
  }

  /* Too narrow for the badge beside a one-line command: stack them. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .cta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .cta-row .ctas {
      padding-top: 0;
    }

    .cta-row .install {
      flex: none;
      width: 100%;
      max-width: 560px;
    }
  }

  .agents-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    font: 12.5px var(--font-mono);
    color: var(--text-3);
  }

  .k {
    padding: 3px 9px;
    color: var(--text-2);
    background: rgb(var(--white-rgb) / 0.02);
    border: 1px solid var(--line);
    border-radius: 6px;
  }

  .stage {
    position: relative;
    width: min(1080px, 100%);
    margin: 48px auto 16px;
    --screen-r: clamp(40px, 12vw, 72px);
    --bezel: 12px;
  }

  .stage::before {
    content: '';
    position: absolute;
    inset: 35% 8% -4%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(var(--violet-rgb) / 0.28), rgb(var(--cyan-rgb) / 0.1) 55%, transparent 80%);
    filter: blur(40px);
  }

  .closeup {
    position: relative;
    width: min(600px, 100%);
    margin: 0 auto;
  }

  .closeup::before {
    content: '';
    position: absolute;
    inset: 30% 0 0;
    z-index: -1;
    border-radius: 0 0 calc(var(--screen-r) + var(--bezel)) calc(var(--screen-r) + var(--bezel));
    box-shadow:
      0 60px 120px -30px rgb(var(--black-rgb) / 0.9),
      0 30px 60px -30px rgb(var(--violet-rgb) / 0.35);
  }

  .bezel {
    padding: 0 var(--bezel) var(--bezel);
    background: var(--bezel-phone);
    border: 1px solid var(--line-2);
    border-top: 0;
    border-radius: 0 0 calc(var(--screen-r) + var(--bezel)) calc(var(--screen-r) + var(--bezel));
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, rgb(var(--black-rgb) / 0.6) 8%, var(--black) 18%);
    mask-image: linear-gradient(to bottom, transparent 0, rgb(var(--black-rgb) / 0.6) 8%, var(--black) 18%);
  }

  .bezel img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0 0 var(--screen-r) var(--screen-r);
  }

  .callout {
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    max-width: 100%;
    margin: 12px auto 0;
    padding: 8px 12px;
    font: var(--fw-caption) var(--fs-caption) var(--font-mono);
    color: var(--text-2);
    text-align: left;
    background: rgb(var(--bg-2-rgb) / 0.86);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-control);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .callout .pill {
    flex: none;
    padding: 2px 7px;
    font-size: 11px;
  }

  .callout + .callout {
    margin-top: 10px;
  }

  @media (max-width: 560px) {
    .hero {
      padding: 40px 0 20px;
    }

    .long {
      display: none;
    }

    .stage {
      margin-top: 32px;
      --bezel: 6px;
    }
  }
</style>
