---
// The home page's first screen: what Waycar is, the Console as proof, and the
// download in reach. On a phone the button sits above the fold; on a computer
// the QR beside it gets the app onto the visitor's phone.
import { Image } from 'astro:assets';
import { ON_APP_STORE } from '../../data/links';
import { iphone } from '../../data/screens';
import { SOURCE_URL } from '../../data/supported';
import AppStoreCta from '../AppStoreCta.astro';
import CodeBlock from '../CodeBlock.astro';

const proof = ['no account, no cloud between you and your sessions', 'SSH keys made on your device', 'a push when an agent is blocked'];
const installCmd = 'curl -fsSL https://waycar.dev/install.sh | sh';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="text">
      <a class="eyebrow" href={SOURCE_URL}>
        <span class="tag">NEW</span><span>Open source<span class="long">: the app, host tools and relay are on GitHub</span></span><span
          class="go"
          aria-hidden="true">→</span
        >
      </a>
      <h1 id="hero-title">
        Every agent.<br /> Every machine.<br />
        <span class="grad-text">One list.</span>
      </h1>
      <p class="lede">
        Waycar is a native iPhone and iPad app for the coding agents you run in herdr or tmux on your own machines. See
        which one is blocked, answer it, or open its real terminal, over SSH or mosh.
      </p>
    </div>

    <div class="cta">
      <div class="get">
        <AppStoreCta kind="hero" ct="site-hero-b" />
        {ON_APP_STORE && <span class="cta-note">Free on the App Store · iOS 18 or later</span>}
      </div>
      {
        ON_APP_STORE && (
          <figure class="scan">
            <img src="/qr/site-qr.svg" alt="" width="88" height="88" loading="lazy" decoding="async" />
            <figcaption>Scan with your iPhone or iPad</figcaption>
          </figure>
        )
      }
    </div>

    <div class="stage">
      <div class="phone">
        <Image
          src={iphone.console.image}
          alt={iphone.console.alt}
          widths={[340, 510, 680, 1020]}
          sizes="(min-width: 1024px) 340px, 300px"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <p class="callout c1" aria-hidden="true"><span class="pill pill-blocked">Blocked</span> on top, waiting on you</p>
      <p class="callout c2" aria-hidden="true"><span class="host">2 Hosts</span> 6 agents, one list</p>
    </div>

    <div class="install" data-ph-copy-event="install_command_copied">
      <p class="install-label">Then run this on each Mac or Linux box:</p>
      <CodeBlock
        title="install Waycar on your Host"
        label="Command to install Waycar for herdr or tmux"
        copy={installCmd}
        lines={[{ kind: 'cmd', text: installCmd, arg: 'https://waycar.dev/install.sh' }]}
      />
    </div>

    <ul class="proof" aria-label="What you get">
      {proof.map((item) => <li>{item}</li>)}
      <li><a href={SOURCE_URL}>open source on GitHub</a></li>
    </ul>
  </div>
</section>

<style>
  /* Phones stack the blocks in DOM order: text, the button, the Console, the
     install command, the proof list. The button has to clear the fold on a
     390x700 screen, so nothing above it may grow. */
  .hero {
    position: relative;
    isolation: isolate;
    /* The Console's glow reaches past the viewport edge; clip it there
       instead of letting the page scroll sideways. */
    overflow-x: clip;
    padding: 28px 0 32px;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(var(--white-rgb) / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--white-rgb) / 0.055) 1px, transparent 1px);
    background-position: center top;
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 20%, var(--black) 10%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 55% at 50% 20%, var(--black) 10%, transparent 75%);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    font: 500 12.5px / 1 var(--font-mono);
    color: var(--text-2);
    background: rgb(var(--white-rgb) / 0.035);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .eyebrow:hover {
    color: var(--text);
    border-color: rgb(var(--violet-soft-rgb) / 0.45);
  }

  .go {
    color: var(--violet-soft);
    transition: transform 0.15s ease;
  }

  .eyebrow:hover .go {
    transform: translateX(2px);
  }

  .tag {
    padding: 4px 8px;
    font-weight: 600;
    color: var(--ink);
    background: var(--grad);
    border-radius: var(--radius-pill);
  }

  h1 {
    margin: 20px 0 16px;
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: transparent;
    background: var(--grad-title);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .lede {
    max-width: 600px;
    font-size: var(--fs-lede);
    line-height: 1.55;
    color: var(--text-2);
  }

  /* ---------- Download ---------- */

  .cta {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 24px;
  }

  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  /* A computer visitor scans this with a phone, so it shows only with a mouse
     on a wide screen (the picker's rule). Hidden, it is never fetched. */
  .scan {
    display: none;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding-left: 28px;
    border-left: 1px solid var(--line);
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 820px) {
    .scan {
      display: flex;
    }

    .get {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .scan img {
    display: block;
    width: 88px;
    height: 88px;
    border-radius: var(--radius-keycap);
  }

  .scan figcaption {
    max-width: 12ch;
    font: var(--fs-caption) / 1.5 var(--font-mono);
    color: var(--text-2);
  }

  /* ---------- Console ---------- */

  .stage {
    position: relative;
    width: min(300px, 82%);
    margin: 40px auto 0;
  }

  .stage::before {
    content: '';
    position: absolute;
    inset: 10% -20% 0;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(var(--violet-rgb) / 0.26), rgb(var(--cyan-rgb) / 0.08) 60%, transparent);
    filter: blur(40px);
  }

  /* The top of the screen, open at the bottom: the status bar, the filters and
     the first agents, Blocked first. */
  .phone {
    padding: 8px 8px 0;
    background: var(--bezel-phone);
    border: 1px solid var(--line-2);
    border-bottom: 0;
    border-radius: 40px 40px 0 0;
    -webkit-mask-image: linear-gradient(to bottom, var(--black) 82%, transparent);
    mask-image: linear-gradient(to bottom, var(--black) 82%, transparent);
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1320 / 2000;
    object-fit: cover;
    object-position: top;
    border-radius: 32px 32px 0 0;
  }

  .callout {
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    padding: 7px 12px;
    font: var(--fw-caption) var(--fs-caption) var(--font-mono);
    color: var(--text-2);
    white-space: nowrap;
    background: rgb(var(--bg-2-rgb) / 0.88);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-control);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .callout .pill {
    padding: 2px 7px;
    font-size: 11px;
  }

  .host {
    color: var(--text);
  }

  .c1,
  .c2 {
    position: absolute;
  }

  .c1 {
    top: 21%;
    left: -22%;
  }

  .c2 {
    top: 40%;
    right: -18%;
  }

  /* ---------- Install and proof ---------- */

  .install {
    width: min(560px, 100%);
    margin: 28px auto 0;
  }

  .install-label {
    margin-bottom: 10px;
    font: 13px var(--font-mono);
    color: var(--text-2);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 22px;
    font: 13px var(--font-mono);
    color: var(--text-2);
  }

  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .proof li::before {
    content: '✓';
    color: var(--cyan);
  }

  .proof a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .proof a:hover {
    color: var(--text);
  }

  /* ---------- Phones ---------- */

  @media (max-width: 560px) {
    .long {
      display: none;
    }

    h1 {
      margin: 16px 0 12px;
    }

    .lede {
      font-size: var(--fs-body);
      line-height: 1.5;
    }

    .cta {
      margin-top: 20px;
    }

    .stage {
      margin-top: 36px;
    }

    /* One callout is enough on a phone; the Host names show on each card. */
    .c1 {
      top: 19%;
      left: -14%;
    }

    .c2 {
      display: none;
    }
  }

  /* ---------- Two columns ---------- */

  @media (min-width: 1024px) {
    .hero {
      padding: 48px 0 56px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 372px;
      grid-template-areas: 'text stage' 'cta stage' 'install stage' 'proof stage';
      grid-template-rows: auto auto auto 1fr;
      column-gap: 72px;
    }

    .text {
      grid-area: text;
    }

    .cta {
      grid-area: cta;
      margin-top: 28px;
    }

    .install {
      grid-area: install;
      max-width: 520px;
      margin: 28px 0 0;
    }

    .proof {
      grid-area: proof;
      align-self: start;
      margin-top: 24px;
    }

    h1 {
      margin: 24px 0 20px;
      font-size: clamp(52px, 5.2vw, 72px);
    }

    .stage {
      grid-area: stage;
      align-self: start;
      width: 372px;
      margin: 0;
    }

    .phone :global(img) {
      aspect-ratio: 1320 / 2280;
    }

    /* Outside the screen, pointing in: the Blocked card, then the card from
       the other Host. */
    .c1,
    .c2 {
      right: calc(100% - 14px);
      left: auto;
    }

    .c1 {
      top: 118px;
    }

    .c2 {
      top: 262px;
    }

    /* The left column is narrow, so the command uses the phone code size and
       may wrap at spaces instead of running under the copy button. */
    .install :global(.window pre) {
      font-size: 12px;
      white-space: pre-wrap;
    }
  }

  /* The text column runs up to the screen here, so the callouts tuck in over
     the screen's left edge instead of reaching into the lede. */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .c1,
    .c2 {
      right: auto;
      left: -40px;
    }
  }

  /* Short laptop screens: tighten the column so the install command still
     shows on the first screen. */
  @media (min-width: 1024px) and (max-height: 800px) {
    .hero {
      padding-top: 32px;
    }

    h1 {
      margin: 18px 0 14px;
      font-size: clamp(48px, 4.6vw, 64px);
    }

    .cta {
      margin-top: 22px;
    }

    .install {
      margin-top: 22px;
    }

    .stage {
      width: 332px;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr) 332px;
    }

    .c1 {
      top: 104px;
    }

    .c2 {
      top: 232px;
    }
  }
</style>
