---
// The home page's first screen sells two things at once: every agent in one
// list (the Console), and talking to it (the dictation clip). The pain comes
// first in the lede, the download stays in reach: on a phone the button sits
// above the fold, on a computer the QR beside it gets the app onto a phone.
import { getImage, Image } from 'astro:assets';
import { ON_APP_STORE } from '../../data/links';
import { dictationHero, iphone } from '../../data/screens';
import { SOURCE_URL } from '../../data/supported';
import AppStoreCta from '../AppStoreCta.astro';
import CodeBlock from '../CodeBlock.astro';

const proof = [
  'no account, no cloud between you and your sessions',
  'a push when an agent is blocked',
  'on-device dictation (iOS 26+)',
  'a Sample to look around before you connect a machine',
];
const installCmd = 'curl -fsSL https://waycar.dev/install.sh | sh';

// The clip goes out as-is (`?url`): astro:assets would flatten the animation.
// Reduced motion gets the still, which does go through astro:assets.
const { still } = dictationHero;
const stillSet = await getImage({ src: still, widths: [660, still.width], format: 'webp', quality: 82 });
// The clip's drawn width (see `.talk` below), minus its bezel.
const clipSizes = '(min-width: 1280px) 330px, (min-width: 1024px) 242px, (min-width: 640px) 362px, calc(100vw - 54px)';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="text">
      <a class="eyebrow" href={SOURCE_URL}>
        <span class="tag">NEW</span><span>Open source<span class="long">: the app, host tools and relay are on GitHub</span></span><span
          class="go"
          aria-hidden="true">→</span
        >
      </a>
      <h1 id="hero-title">
        Every agent.<br /> One list.<br />
        <span class="grad-text">Just talk.</span>
      </h1>
      <p class="lede">
        You step away. An agent asks a question and sits there until you're back. Waycar tells you, shows every agent on
        every machine in one list, and lets you answer out loud.
      </p>
    </div>

    <div class="cta">
      <div class="get">
        <AppStoreCta kind="hero" ct="site-hero-b" />
        {ON_APP_STORE && <span class="cta-note">Free on the App Store · iOS 18 or later</span>}
      </div>
      {
        ON_APP_STORE && (
          <figure class="scan">
            <img src="/qr/site-qr.svg" alt="" width="88" height="88" loading="lazy" decoding="async" />
            <figcaption>Scan with your iPhone or iPad</figcaption>
          </figure>
        )
      }
    </div>

    <p class="what">A native iPhone and iPad app for agents in herdr or tmux on your own machines, over SSH or mosh.</p>

    <div class="stage">
      <figure class="list">
        <div class="phone">
          <Image
            src={iphone.console.image}
            alt={iphone.console.alt}
            widths={[300, 450, 600, 900]}
            sizes="(min-width: 1280px) 240px, (min-width: 1024px) 188px, (min-width: 640px) 228px, min(284px, 78vw)"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
          />
        </div>
        <figcaption><span class="pill pill-blocked">Blocked</span> on top. 2 machines, 6 agents, one list.</figcaption>
      </figure>

      <figure class="talk">
        <div class="bezel">
          <picture>
            <source media="(prefers-reduced-motion: reduce)" type="image/webp" srcset={stillSet.srcSet.attribute} sizes={clipSizes} />
            <img
              src={dictationHero.anim}
              srcset={`${dictationHero.anim660} 660w, ${dictationHero.anim} ${still.width}w`}
              sizes={clipSizes}
              width={still.width}
              height={still.height}
              alt={dictationHero.alt}
              loading="lazy"
              decoding="async"
            />
          </picture>
        </div>
        <figcaption><span class="pill pill-mosh">MIC</span> answer out loud, then check it and send</figcaption>
      </figure>
    </div>

    <div class="install" data-ph-copy-event="install_command_copied">
      <p class="install-label">Then run this on each Mac or Linux box:</p>
      <CodeBlock
        title="install Waycar on your Host"
        label="Command to install Waycar for herdr or tmux"
        copy={installCmd}
        lines={[{ kind: 'cmd', text: installCmd, arg: 'https://waycar.dev/install.sh' }]}
      />
    </div>

    <ul class="proof" aria-label="What you get">
      {proof.map((item) => <li>{item}</li>)}
      <li><a href={SOURCE_URL}>open source on GitHub</a></li>
    </ul>
  </div>
</section>

<style>
  /* Phones stack the blocks in DOM order: text, the button, what it is, the
     Console, the clip, the install command, the proof list. The button has to
     clear the fold on a 390x700 screen, so nothing above it may grow. */
  .hero {
    position: relative;
    isolation: isolate;
    /* The glow reaches past the viewport edge; clip it there instead of
       letting the page scroll sideways. */
    overflow-x: clip;
    padding: 28px 0 32px;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(var(--white-rgb) / 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--white-rgb) / 0.055) 1px, transparent 1px);
    background-position: center top;
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(ellipse 70% 55% at 50% 20%, var(--black) 10%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 55% at 50% 20%, var(--black) 10%, transparent 75%);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    font: 500 12.5px / 1 var(--font-mono);
    color: var(--text-2);
    background: rgb(var(--white-rgb) / 0.035);
    border: 1px solid var(--line-2);
    border-radius: var(--radius-pill);
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .eyebrow:hover {
    color: var(--text);
    border-color: rgb(var(--violet-soft-rgb) / 0.45);
  }

  .go {
    color: var(--violet-soft);
    transition: transform 0.15s ease;
  }

  .eyebrow:hover .go {
    transform: translateX(2px);
  }

  .tag {
    padding: 4px 8px;
    font-weight: 600;
    color: var(--ink);
    background: var(--grad);
    border-radius: var(--radius-pill);
  }

  h1 {
    margin: 20px 0 16px;
    font-size: var(--fs-display);
    font-weight: var(--fw-display);
    line-height: var(--lh-display);
    letter-spacing: var(--ls-display);
    color: transparent;
    background: var(--grad-title);
    -webkit-background-clip: text;
    background-clip: text;
  }

  .lede {
    max-width: 600px;
    font-size: var(--fs-lede);
    line-height: 1.55;
    color: var(--text-2);
  }

  /* ---------- Download ---------- */

  .cta {
    display: flex;
    align-items: center;
    gap: 28px;
    margin-top: 24px;
  }

  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
  }

  .get .cta-note {
    white-space: nowrap;
  }

  /* A computer visitor scans this with a phone, so it shows only with a mouse
     on a wide screen (the picker's rule). Hidden, it is never fetched. */
  .scan {
    display: none;
    align-items: center;
    gap: 14px;
    margin: 0;
    padding-left: 28px;
    border-left: 1px solid var(--line);
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 820px) {
    .scan {
      display: flex;
    }

    .get {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .scan img {
    display: block;
    width: 88px;
    height: 88px;
    border-radius: var(--radius-keycap);
  }

  .scan figcaption {
    max-width: 12ch;
    font: var(--fs-caption) / 1.5 var(--font-mono);
    color: var(--text-2);
  }

  /* What it is, in one quieter line: under the button on a phone, under the
     lede's column on a computer. */
  .what {
    max-width: 52ch;
    margin-top: 16px;
    font: 13px / 1.55 var(--font-mono);
    color: var(--text-3);
  }

  /* ---------- The two visuals ---------- */

  /* One list, then the answer: the Console and the clip read left to right on
     tablets and computers, top to bottom on phones. Each caption sits under
     its picture, never on it. */
  .stage {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 32px;
    margin-top: 36px;
  }

  .stage::before {
    content: '';
    position: absolute;
    inset: 5% -10% 10%;
    z-index: -1;
    background: radial-gradient(closest-side, rgb(var(--violet-rgb) / 0.24), rgb(var(--cyan-rgb) / 0.08) 60%, transparent);
    filter: blur(40px);
  }

  figure {
    margin: 0;
  }

  .stage figcaption {
    margin-top: 14px;
    font: var(--fw-caption) var(--fs-caption) / 1.7 var(--font-mono);
    color: var(--text-2);
    text-align: center;
    text-wrap: balance;
  }

  .stage figcaption .pill {
    margin-right: 4px;
    padding: 2px 7px;
    font-size: 11px;
  }

  .list {
    width: min(300px, 82vw);
  }

  /* The top of the Console, open at the bottom: the status bar, the filters
     and the first agents, Blocked first. */
  .phone {
    padding: 8px 8px 0;
    background: var(--bezel-phone);
    border: 1px solid var(--line-2);
    border-bottom: 0;
    border-radius: 40px 40px 0 0;
    -webkit-mask-image: linear-gradient(to bottom, var(--black) 80%, transparent);
    mask-image: linear-gradient(to bottom, var(--black) 80%, transparent);
  }

  .phone :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1320 / 1560;
    object-fit: cover;
    object-position: top;
    border-radius: 32px 32px 0 0;
  }

  /* The bottom of an agent's screen, open at the top. */
  .talk {
    --screen-r: 36px;
    --bezel: 8px;
    position: relative;
    width: 100%;
    max-width: 420px;
  }

  .talk .bezel {
    padding: 0 var(--bezel) var(--bezel);
    background: var(--bezel-phone);
    border: 1px solid var(--line-2);
    border-top: 0;
    border-radius: 0 0 calc(var(--screen-r) + var(--bezel)) calc(var(--screen-r) + var(--bezel));
    box-shadow:
      0 40px 80px -30px rgb(var(--black-rgb) / 0.9),
      0 24px 48px -28px rgb(var(--violet-rgb) / 0.35);
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, rgb(var(--black-rgb) / 0.6) 6%, var(--black) 16%);
    mask-image: linear-gradient(to bottom, transparent 0, rgb(var(--black-rgb) / 0.6) 6%, var(--black) 16%);
  }

  .talk img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0 0 var(--screen-r) var(--screen-r);
  }

  /* ---------- Install and proof ---------- */

  .install {
    width: min(560px, 100%);
    margin: 36px auto 0;
  }

  .install-label {
    margin-bottom: 10px;
    font: 13px var(--font-mono);
    color: var(--text-2);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 22px;
    font: 13px var(--font-mono);
    color: var(--text-2);
  }

  .proof li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .proof li::before {
    content: '✓';
    color: var(--cyan);
  }

  .proof a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .proof a:hover {
    color: var(--text);
  }

  /* ---------- Phones ---------- */

  @media (max-width: 560px) {
    .long {
      display: none;
    }

    h1 {
      margin: 16px 0 12px;
    }

    .lede {
      font-size: var(--fs-body);
      line-height: 1.5;
    }

    .cta {
      margin-top: 20px;
    }

    .what {
      margin-top: 14px;
      font-size: 12.5px;
    }

    .stage {
      margin-top: 32px;
    }

    .talk {
      --screen-r: 28px;
      --bezel: 6px;
    }
  }

  /* ---------- Side by side ---------- */

  /* The clip sits lower than the Console, so the eye goes from the list down
     to the answer. */
  @media (min-width: 640px) {
    .stage {
      grid-template-columns: 244px minmax(0, 380px);
      justify-content: center;
      align-items: end;
      gap: 28px;
      margin-top: 44px;
    }

    .list {
      width: 244px;
    }

    .talk {
      max-width: none;
    }
  }

  /* ---------- Two columns ---------- */

  @media (min-width: 1024px) {
    .hero {
      padding: 44px 0 56px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'text stage' 'cta stage' 'what stage' 'install stage' 'proof stage';
      grid-template-rows: auto auto auto auto 1fr;
      column-gap: 48px;
    }

    .text {
      grid-area: text;
    }

    .cta {
      grid-area: cta;
      margin-top: 28px;
    }

    .what {
      grid-area: what;
      margin-top: 20px;
    }

    .install {
      grid-area: install;
      max-width: 520px;
      margin: 28px 0 0;
    }

    .proof {
      grid-area: proof;
      align-self: start;
      margin-top: 24px;
    }

    h1 {
      margin: 22px 0 18px;
      font-size: clamp(52px, 5vw, 72px);
    }

    .stage {
      grid-area: stage;
      align-self: start;
      grid-template-columns: 204px 260px;
      gap: 20px;
      margin: 0;
    }

    .list {
      width: 204px;
    }

    .phone :global(img) {
      aspect-ratio: 1320 / 2000;
    }

    /* Narrow left column: the QR caption goes under the code. */
    .scan {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .scan figcaption {
      max-width: none;
    }

    .long {
      display: none;
    }

    /* The left column is narrow, so the command uses the phone code size and
       may wrap at spaces instead of running under the copy button. */
    .install :global(.window pre) {
      font-size: 12px;
      white-space: pre-wrap;
    }
  }

  @media (min-width: 1280px) {
    .hero-grid {
      column-gap: 48px;
    }

    .stage {
      grid-template-columns: 256px 348px;
      gap: 24px;
    }

    .list {
      width: 256px;
    }

    .phone :global(img) {
      aspect-ratio: 1320 / 2280;
    }

    .scan {
      flex-direction: row;
      align-items: center;
      gap: 14px;
    }

    .scan figcaption {
      max-width: 12ch;
    }

    .long {
      display: inline;
    }
  }

  /* Short laptop screens: tighten the column so the button and QR stay on the
     first screen. */
  @media (min-width: 1024px) and (max-height: 800px) {
    .hero {
      padding-top: 28px;
    }

    h1 {
      margin: 16px 0 14px;
      font-size: clamp(46px, 4.4vw, 60px);
    }

    .lede {
      font-size: var(--fs-body);
      line-height: 1.5;
    }

    .cta {
      margin-top: 20px;
    }

    .what {
      margin-top: 16px;
    }

    .install {
      margin-top: 22px;
    }

    .phone :global(img) {
      aspect-ratio: 1320 / 1800;
    }
  }

  @media (min-width: 1280px) and (max-height: 800px) {
    .stage {
      grid-template-columns: 248px 350px;
    }

    .list {
      width: 248px;
    }
  }
</style>
