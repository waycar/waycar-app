---
import { getImage } from 'astro:assets';
import PhoneShot from './PhoneShot.astro';
import { chat, dictationHero } from '../../data/screens';

// The dictation clip: the bottom of an agent's screen while Dictate to Agent
// listens. The animated webp goes out as-is (`?url`) and lazy, so it is only
// fetched when the visitor scrolls near; reduced motion gets the still.
const { still } = dictationHero;
const stillSet = await getImage({ src: still, widths: [660, still.width], format: 'webp', quality: 82 });
// The clip's drawn width: the 420px points column, or the stage minus its padding.
const clipSizes = '(min-width: 721px) 404px, calc(100vw - 92px)';
---

<section id="talk" class="section talk" aria-labelledby="talk-title">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Just talk</span>
      <h2 id="talk-title" class="sec-title">Say what's next.<br /> <span class="muted">Your agent takes it from there.</span></h2>
      <p class="sec-lede">Tap the mic under an agent's terminal and talk. Tap stop, and your words go to the agent as a message. If it's waiting on a question, they land in the Composer so you can check them first.</p>
    </div>

    <div class="glass stage">
      <PhoneShot image={chat.iphone.image} alt={chat.iphone.alt} />
      <div class="side">
        <figure class="clip">
          <div class="clip-frame">
            <picture>
              <source media="(prefers-reduced-motion: reduce)" type="image/webp" srcset={stillSet.srcSet.attribute} sizes={clipSizes} />
              <img
                src={dictationHero.anim}
                srcset={`${dictationHero.anim660} 660w, ${dictationHero.anim} ${still.width}w`}
                sizes={clipSizes}
                width={still.width}
                height={still.height}
                alt={dictationHero.alt}
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <figcaption><span class="pill pill-mosh">MIC</span> tap, talk, tap stop</figcaption>
        </figure>
        <ul class="points">
          <li>
            <h3>Want to check it first?</h3>
            <p>Dictate into the Composer instead. Fix a word if you need to, then tap Send.</p>
          </li>
          <li>
            <h3>Or skip the terminal</h3>
            <p>
              Start Claude Code, Codex, omp or pi with Chat Mode on, and it opens as a simple chat. When the agent asks for
              permission, tap Allow or Cancel right there. Codex and OpenCode 2 server sessions are chats from the start.
            </p>
          </li>
          <li>
            <h3>Your voice stays on your phone</h3>
            <p>Apple's on-device model turns speech into text. The audio is never recorded or sent. Needs iOS 26 or later.</p>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Stage and glow rules copied from page A's ChatMode.astro on purpose, for A/B test isolation. */
  .talk::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 520px;
    background: radial-gradient(640px 300px at 20% 10%, rgb(var(--violet-rgb) / 0.09), transparent 70%);
    pointer-events: none;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 340px) minmax(0, 420px);
    justify-content: space-evenly;
    align-items: center;
    gap: 48px;
    padding: 48px 40px;
  }

  .side {
    display: grid;
    gap: 32px;
  }

  /* The clip is the bottom of a phone screen, so its frame is open at the top
     and rounded below, like the screen it was cut from. */
  .clip {
    margin: 0;
  }

  .clip-frame {
    padding: 0 8px 8px;
    background: var(--surface-2);
    border: 1px solid var(--line-2);
    border-top: 0;
    border-radius: 0 0 40px 40px;
    -webkit-mask-image: linear-gradient(to bottom, transparent 0, var(--black) 14%);
    mask-image: linear-gradient(to bottom, transparent 0, var(--black) 14%);
  }

  .clip img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0 0 32px 32px;
  }

  .clip figcaption {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    font: var(--fw-caption) var(--fs-caption) var(--font-mono);
    color: var(--text-2);
  }

  .clip .pill {
    padding: 2px 7px;
    font-size: 11px;
  }

  .points {
    display: grid;
    gap: 24px;
  }

  .points h3 {
    margin: 0 0 6px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .points p {
    max-width: 400px;
    font-size: 15px;
    color: var(--text-2);
  }

  @media (max-width: 720px) {
    .stage {
      grid-template-columns: 1fr;
      gap: 36px;
      padding: 28px 20px;
    }

    /* The clip says "talk" before the chat does. */
    .side {
      display: contents;
    }

    .clip {
      order: -1;
    }
  }
</style>
