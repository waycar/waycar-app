---
// The skeptic's question, answered in ten seconds: what plain SSH and tmux
// attach leave you doing by hand, row by row. A real table; on phones each row
// puts its question above the two answers, which stay side by side, so the
// table never scrolls sideways. The roles keep it a table to screen readers
// once CSS changes the cells' display. The download sits right under the
// argument, for the visitor it just convinced.
import { ON_APP_STORE } from '../../data/links';
import AppStoreCta from '../AppStoreCta.astro';

const rows = [
  {
    q: 'Who needs you?',
    ssh: 'Attach to each session and look.',
    waycar: 'One list across machines. Blocked ones on top.',
  },
  {
    q: 'When to look?',
    ssh: 'When you remember to check.',
    waycar: 'A push when an agent is Blocked or Done.',
  },
  {
    q: 'Answering',
    ssh: 'Type into a full-screen TUI with your thumbs.',
    waycar: 'Say it out loud, or tap Allow or Cancel in Chat Mode.',
  },
  {
    q: 'Changing networks',
    ssh: 'The session drops. Reattach by hand.',
    waycar: 'mosh keeps the terminal attached from Wi-Fi to cellular.',
  },
];
---

<section id="why" class="section" aria-labelledby="why-title">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">Why not SSH</span>
      <h2 id="why-title" class="sec-title">You could just SSH in. <span class="muted">Here is what you would still do by hand.</span></h2>
    </div>

    <div class="glass board">
      <table role="table" aria-labelledby="why-title">
        <thead role="rowgroup">
          <tr role="row">
            <td class="corner" role="cell"></td>
            <th scope="col" role="columnheader">Plain SSH and tmux attach</th>
            <th scope="col" role="columnheader" class="ours">Waycar</th>
          </tr>
        </thead>
        <tbody role="rowgroup">
          {
            rows.map((row) => (
              <tr role="row">
                <th scope="row" role="rowheader">{row.q}</th>
                <td role="cell" class="theirs">{row.ssh}</td>
                <td role="cell" class="ours">{row.waycar}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="still">It is still your terminal. Open any agent's real TUI when you want it.</p>
    <div class="after">
      <div class="get">
        <AppStoreCta kind="button">Get Waycar</AppStoreCta>
        {ON_APP_STORE && <span class="cta-note">Free on the App Store · iOS 18 or later</span>}
      </div>
      <a class="more" href="/compare">See Waycar next to Termius, Blink Shell and Claude Code Remote Control →</a>
    </div>
  </div>
</section>

<style>
  /* The second sentence is its own block, so it balances by itself and never
     leaves one word on the last line. */
  .sec-title .muted {
    display: block;
    text-wrap: balance;
  }

  .board {
    padding: 8px 32px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }

  th,
  td {
    padding: 18px 20px 18px 0;
    vertical-align: top;
  }

  thead th {
    padding-top: 22px;
    padding-bottom: 14px;
    font: var(--fw-label) var(--fs-label) / 1.4 var(--font-mono);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-3);
  }

  thead th.ours {
    color: var(--violet-soft);
  }

  tbody tr {
    border-top: 1px solid var(--line);
  }

  tbody th {
    width: 24%;
    font-size: var(--fs-body);
    font-weight: 600;
    color: var(--text);
  }

  .theirs {
    width: 36%;
    font-size: 15px;
    color: var(--text-3);
  }

  td.ours {
    font-size: 15px;
    color: var(--text);
  }

  td.ours::before {
    content: '✓';
    margin-right: 8px;
    color: var(--cyan);
  }

  .still {
    margin-top: 28px;
    color: var(--text-2);
  }

  .after {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    margin-top: 20px;
  }

  .get {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }

  .more {
    font: 14px var(--font-mono);
    color: var(--violet-soft);
    text-decoration: underline;
    text-decoration-color: rgb(var(--violet-soft-rgb) / 0.4);
    text-underline-offset: 3px;
  }

  .more:hover {
    color: var(--text);
  }

  /* Phones: the question spans the row, its two answers sit side by side. */
  @media (max-width: 640px) {
    .board {
      padding: 4px 18px;
    }

    .corner {
      display: none;
    }

    thead tr,
    tbody tr {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 16px;
    }

    th,
    td,
    tbody th,
    .theirs {
      width: auto;
      padding: 0;
    }

    thead th {
      padding: 18px 0 12px;
    }

    tbody tr {
      padding: 16px 0 18px;
    }

    tbody th {
      grid-column: 1 / -1;
      margin-bottom: 8px;
      font-size: 15px;
    }

    .theirs,
    td.ours {
      font-size: 14px;
      line-height: 1.5;
    }

    td.ours::before {
      margin-right: 6px;
    }
  }
</style>
