---
// Page B only, after JustTalk. Waycar in CarPlay (1.3.0), told as the spoken
// exchange it is: the car's screen shows only the list, so the visual is what
// you hear, in the app's own lines (VoiceExchange). Never a picture of the
// car's screen. Details live on /carplay.
import VoiceExchange, { type ExchangeLine } from '../VoiceExchange.astro';

const exchange: ExchangeLine[] = [
  { by: 'tap', text: 'Talk to Waycar' },
  { by: 'waycar', text: '2 Agents need you. api Claude is blocked. web Codex is done.' },
  { by: 'tap', text: 'api · Claude' },
  { by: 'waycar', text: 'api Claude is waiting on approval to run npm test. Allow or deny?' },
  { by: 'you', text: 'Allow.' },
  { by: 'waycar', text: 'Allowed.' },
];
---

<section id="road" class="section road" aria-labelledby="road-title">
  <div class="wrap">
    <div class="sec-head">
      <span class="kicker">On the drive</span>
      <h2 id="road-title" class="sec-title">
        Unblock an agent on your drive. <span class="muted">Nothing to read.</span>
      </h2>
      <p class="sec-lede">
        Waycar in CarPlay says which agents need you. Answer by voice, with your iPhone locked.
      </p>
    </div>

    <div class="glass stage">
      <VoiceExchange lines={exchange} label="A drive with Waycar in CarPlay: what you tap, hear and say" />
      <div class="side">
        <ul class="points">
          <li>
            <h3>Ask how it's going</h3>
            <p>Tap an agent and ask. You hear the answer in a sentence or two.</p>
          </li>
          <li>
            <h3>Risky commands wait</h3>
            <p>A force-push, a deploy or <code>sudo</code> is held until you're stopped.</p>
          </li>
          <li>
            <h3>You hear it, never read it</h3>
            <p>The car's screen lists your agents and how long each has waited. Nothing an agent writes is shown.</p>
          </li>
        </ul>
        <p class="more">
          <a class="btn btn-ghost" href="/carplay">Waycar in CarPlay <span aria-hidden="true">→</span></a>
          <span class="req">iPhone, iOS 26.4 or later</span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .road::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 520px;
    background: radial-gradient(640px 300px at 80% 10%, rgb(var(--cyan-rgb) / 0.08), transparent 70%);
    pointer-events: none;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 560px) minmax(0, 340px);
    justify-content: space-evenly;
    align-items: center;
    gap: 48px;
    padding: 48px 40px;
  }

  .points {
    display: grid;
    gap: 28px;
  }

  .points h3 {
    margin: 0 0 6px;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .points p {
    max-width: 400px;
    font-size: 15px;
    color: var(--text-2);
  }

  .more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
    margin-top: 32px;
  }

  .req {
    font: var(--fs-caption) var(--font-mono);
    color: var(--text-3);
  }

  @media (max-width: 860px) {
    .stage {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 28px 20px;
    }
  }
</style>
