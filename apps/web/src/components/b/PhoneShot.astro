---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  crop?: boolean;
}

const { image, alt, crop = false } = Astro.props;
---

<div class="shot">
  <div class="phone">
    <Image
      src={image}
      alt={alt}
      class:list={['screen', { crop }]}
      widths={[320, 480, 720]}
      sizes="(min-width: 721px) 320px, 70vw"
      format="webp"
      quality={80}
    />
  </div>
  <slot />
</div>

<style>
  .shot {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 340px;
  }

  .phone {
    padding: 8px;
    background: var(--surface-2);
    border: 1px solid var(--line-2);
    border-radius: 40px;
    box-shadow:
      0 40px 100px -30px rgb(var(--black-rgb) / 0.9),
      0 30px 80px -40px rgb(var(--violet-rgb) / 0.5);
  }

  .screen {
    border-radius: 32px;
  }

  .screen.crop {
    aspect-ratio: 1320 / 1560;
    object-fit: cover;
    object-position: top;
  }

  @media (max-width: 720px) {
    .shot {
      max-width: 300px;
    }
  }
</style>
