          "done": 2,
          "total": 4
        },
        "progress_ts": 1760000000000,
        "declares_progress": true
      }
    },
    {
      "name": "progress_ts without progress is ignored",
      "line": "{\"v\":1,\"pane\":\"w1:p1\",\"status\":\"working\",\"summary\":\"Adding backoff to webhook retries\",\"ts\":1760000000000,\"hash\":\"ab12\",\"progress_ts\":1760000090000}",
      "expected": {
        "pane": "w1:p1",
        "status": "working",
        "summary": "Adding backoff to webhook retries",
