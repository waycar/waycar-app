    {
      "name": "another store version is dropped",
      "line": "{\"v\":2,\"pane\":\"w1:p1\",\"status\":\"working\",\"summary\":\"Adding backoff to webhook retries\",\"ts\":1760000000000,\"hash\":\"ab12\",\"progress\":{\"done\":3,\"total\":7}}",
