      }
    },
    {
      "name": "progress_ts with only invalid progress is ignored",
      "line": "{\"v\":1,\"pane\":\"w1:p1\",\"status\":\"working\",\"summary\":\"Adding backoff to webhook retries\",\"ts\":1760000000000,\"hash\":\"ab12\",\"progress\":{\"done\":9,\"total\":7},\"progress_ts\":1760000090000}",
      "expected": {
        "pane": "w1:p1",
        "status": "working",
        "summary": "Adding backoff to webhook retries",
        "ts": 1760000000000,
        "progress": null,
        "declares_progress": true
      }
    },
    {
      "name": "progress_ts as a string is ignored, the progress kept",
      "line": "{\"v\":1,\"pane\":\"w1:p1\",\"status\":\"working\",\"summary\":\"Adding backoff to webhook retries\",\"ts\":1760000000000,\"hash\":\"ab12\",\"progress\":{\"done\":3,\"total\":7},\"progress_ts\":\"1760000090000\"}",
      "expected": {
        "pane": "w1:p1",
        "status": "working",
        "summary": "Adding backoff to webhook retries",
