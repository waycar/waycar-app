      "expected": { "pane": "zellij:work/terminal_2", "kind": "claude", "status": "working", "seq": 3, "session": "0f6c2b1e-1b2a-4c3d-9e8f-001122334455", "transcript": "/home/waycar/.claude/projects/-home-waycar-work-demo/0f6c2b1e-1b2a-4c3d-9e8f-001122334455.jsonl", "launch": "w-7Q2C9KJ4", "updatedMs": 1794448338909 }
