{
  "description": "Shared Zellij pane-state test vectors, v1. Single source of truth for the per-pane state documents Waycar's Host Tools (bin/waycar-hook, `waycar hook-status`, `waycar hook-session`, the omp/pi/opencode/kilo extensions) write for Zellij panes, and the app's ZellijTransport reads through its change feed; consumed by the Rust plugin tests and the Swift app tests (design docs/design/zellij-backend.md §1, §5, §6). `paneIds` pins the pane id grammar (Zellij session names cannot contain '/'), `fileNames` the file name (atomic.rs pane_file_name: unpadded base64url of the UTF-8 pane id plus .json), `documents` what the app derives from a document (null = the app ignores the document).",
  "directory": "$HOME/.local/state/waycar/zellij (XDG_STATE_HOME is ignored on purpose: the app reads it from a bare SSH exec)",
  "statusValues": ["working", "blocked", "done", "idle"],
  "paneIds": [
    { "id": "zellij:work/terminal_0", "expected": { "session": "work", "pane": 0 } },
    { "id": "zellij:my project/terminal_12", "expected": { "session": "my project", "pane": 12 } },
    { "id": "zellij:a:b/terminal_3", "expected": { "session": "a:b", "pane": 3 } },
    { "id": "zellij:work/terminal_", "expected": null },
    { "id": "zellij:work/terminal_01", "expected": null },
    { "id": "zellij:work/terminal_-1", "expected": null },
    { "id": "zellij:work/plugin_2", "expected": null },
    { "id": "zellij:/terminal_1", "expected": null },
    { "id": "zellij:a/b/terminal_1", "expected": null },
    { "id": "zellij:work", "expected": null },
    { "id": "tmux:%1", "expected": null },
    { "id": "hc:t1", "expected": null }
