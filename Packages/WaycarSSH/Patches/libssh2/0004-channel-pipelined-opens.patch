     int port, int *bound_port,
diff --git a/src/channel.c b/src/channel.c
index eb3f0e8..fec27c2 100644
--- a/src/channel.c
+++ b/src/channel.c
@@ -489,6 +489,358 @@ LIBSSH2_CHANNEL *libssh2_channel_direct_streamlocal_ex(
     return ptr;
 }
 
+/*
+ * Waycar patch: pipelined channel opens.
+ *
+ * ssh2_channel_open() keeps an unfinished open in session state (open_*), so
+ * a second open entered during the first one's EAGAIN would resume the first.
+ * These keep the request on the channel instead: _start builds it without any
+ * I/O, _finish sends it and then waits for this channel's reply only, so
+ * several opens can be awaiting their replies at once. Sends still go through
+ * the one session transport, so a request the transport holds partially sent
+ * must be resumed (by its own _finish) before any other packet can go out.
+ */
+static void channel_open_nb_release(LIBSSH2_CHANNEL *channel)
+{
+    LIBSSH2_SESSION *session = channel->session;
+
+    if(channel->openNB_packet)
+        SSH2_SAFEFREE(session, channel->openNB_packet);
+    if(channel->openNB_message)
+        SSH2_SAFEFREE(session, channel->openNB_message);
+}
+
+/* Refused or failed: nothing to close on the server, only free locally. */
+static int channel_open_nb_fail(LIBSSH2_CHANNEL *channel, int errcode,
+                                const char *errmsg)
+{
+    channel_open_nb_release(channel);
+    channel->openNB_state = ssh2_NB_state_end;
+    channel->local.close = 1;
+    channel->remote.close = 1;
+    return ssh2_err(channel->session, errcode, errmsg);
+}
+
+/* Takes ownership of message, which must come from SSH2_ALLOC. */
+static LIBSSH2_CHANNEL *channel_open_start(LIBSSH2_SESSION *session,
+                                           const char *channel_type,
+                                           uint32_t channel_type_len,
+                                           uint32_t window_size,
+                                           uint32_t packet_size,
+                                           unsigned char *message,
+                                           size_t message_len)
+{
+    LIBSSH2_CHANNEL *channel;
+    unsigned char *s;
+
+    channel = SSH2_CALLOC(session, sizeof(LIBSSH2_CHANNEL));
+    if(!channel) {
+        if(message)
+            SSH2_FREE(session, message);
+        ssh2_err(session, LIBSSH2_ERROR_ALLOC,
+                 "Unable to allocate space for channel data");
+        return NULL;
+    }
+    channel->session = session;
+    channel->openNB_message = message;
+    channel->openNB_message_len = message_len;
+    channel->channel_type_len = channel_type_len;
+    channel->channel_type = SSH2_ALLOC(session, channel_type_len);
+    /* 17 = packet_type(1) + channel_type_len(4) + sender_channel(4) +
+       window_size(4) + packet_size(4) */
+    channel->openNB_packet_len = channel_type_len + 17;
+    channel->openNB_packet = SSH2_ALLOC(session, channel->openNB_packet_len);
+    if(!channel->channel_type || !channel->openNB_packet) {
+        channel_open_nb_release(channel);
+        if(channel->channel_type)
+            SSH2_FREE(session, channel->channel_type);
+        SSH2_FREE(session, channel);
+        ssh2_err(session, LIBSSH2_ERROR_ALLOC,
+                 "Unable to allocate memory for channel-open request");
+        return NULL;
+    }
+    memcpy(channel->channel_type, channel_type, channel_type_len);
+
+    /* REMEMBER: local as in locally sourced */
+    channel->local.id = ssh2_channel_nextid(session);
+    channel->remote.window_size = window_size;
+    channel->remote.window_size_initial = window_size;
+    channel->remote.packet_size = packet_size;
+
+    s = channel->openNB_packet;
+    *(s++) = SSH_MSG_CHANNEL_OPEN;
+    ssh2_store_str(&s, channel_type, channel_type_len);
+    ssh2_store_u32(&s, channel->local.id);
+    ssh2_store_u32(&s, window_size);
+    ssh2_store_u32(&s, packet_size);
+
+    channel->openNB_state = ssh2_NB_state_created;
+    ssh2_list_add(&session->channels, &channel->node);
+
+    ssh2_deb((session, LIBSSH2_TRACE_CONN,
+              "Prepared pipelined channel open %u - win %u pack %u",
+              channel->local.id, window_size, packet_size));
+    return channel;
+}
+
+static int channel_open_finish(LIBSSH2_CHANNEL *channel)
+{
+    static const unsigned char reply_codes[3] = {
+        SSH_MSG_CHANNEL_OPEN_CONFIRMATION,
+        SSH_MSG_CHANNEL_OPEN_FAILURE,
+        0
+    };
+
+    LIBSSH2_SESSION *session = channel->session;
+    unsigned char local_channel[4];
+    unsigned char *data;
+    size_t data_len;
+    uint32_t reason_code;
+    int rc;
+
+    if(channel->openNB_state == ssh2_NB_state_idle)
+        return 0;
+    if(channel->openNB_state == ssh2_NB_state_end)
+        return ssh2_err(session, LIBSSH2_ERROR_BAD_USE,
+                        "Channel open was refused or failed");
+
+    if(channel->openNB_state == ssh2_NB_state_created)
+        channel->openNB_state = ssh2_NB_state_sent;
+
+    if(channel->openNB_state == ssh2_NB_state_sent) {
+        rc = ssh2_transport_send(session, channel->openNB_packet,
+                                 channel->openNB_packet_len,
+                                 channel->openNB_message,
+                                 channel->openNB_message_len);
+        if(rc == LIBSSH2_ERROR_EAGAIN) {
+            ssh2_err(session, rc, "Would block sending channel-open request");
+            return rc;
+        }
+        else if(rc)
+            return channel_open_nb_fail(channel, rc,
+                                        "Unable to send channel-open request");
+
+        channel_open_nb_release(channel);
+        memset(&channel->openNB_requirev_state, 0,
+               sizeof(channel->openNB_requirev_state));
+        channel->openNB_state = ssh2_NB_state_sent1;
+    }
+
+    ssh2_htonu32(local_channel, channel->local.id);
+    rc = ssh2_packet_requirev(session, reply_codes, &data, &data_len,
+                              1, local_channel, 4,
+                              &channel->openNB_requirev_state);
+    if(rc == LIBSSH2_ERROR_EAGAIN) {
+        ssh2_err(session, rc, "Would block waiting for channel-open reply");
+        return rc;
+    }
+    else if(rc)
+        return channel_open_nb_fail(channel, rc,
+                                    "Failed waiting for channel-open reply");
+
+    if(data_len >= 17 && data[0] == SSH_MSG_CHANNEL_OPEN_CONFIRMATION) {
+        channel->remote.id = ssh2_ntohu32(data + 5);
+        channel->local.window_size = ssh2_ntohu32(data + 9);
+        channel->local.window_size_initial = ssh2_ntohu32(data + 9);
+        channel->local.packet_size = ssh2_ntohu32(data + 13);
+        SSH2_FREE(session, data);
+        channel->openNB_state = ssh2_NB_state_idle;
+        ssh2_deb((session, LIBSSH2_TRACE_CONN,
+                  "Connection Established - ID: %u/%u win: %u/%u"
+                  " pack: %u/%u",
+                  channel->local.id, channel->remote.id,
+                  channel->local.window_size, channel->remote.window_size,
+                  channel->local.packet_size, channel->remote.packet_size));
+        return 0;
+    }
+
+    if(data_len < 9 || data[0] != SSH_MSG_CHANNEL_OPEN_FAILURE) {
+        SSH2_FREE(session, data);
+        return channel_open_nb_fail(channel, LIBSSH2_ERROR_PROTO,
+                                    "Unexpected packet size");
+    }
+
+    reason_code = ssh2_ntohu32(data + 5);
+    SSH2_FREE(session, data);
+    switch(reason_code) {
+    case SSH_OPEN_ADMINISTRATIVELY_PROHIBITED:
+        return channel_open_nb_fail(channel, LIBSSH2_ERROR_CHANNEL_FAILURE,
+            "Channel open failure (administratively prohibited)");
+    case SSH_OPEN_CONNECT_FAILED:
+        return channel_open_nb_fail(channel, LIBSSH2_ERROR_CHANNEL_FAILURE,
+            "Channel open failure (connect failed)");
+    case SSH_OPEN_UNKNOWN_CHANNELTYPE:
+        return channel_open_nb_fail(channel, LIBSSH2_ERROR_CHANNEL_FAILURE,
+            "Channel open failure (unknown channel type)");
+    case SSH_OPEN_RESOURCE_SHORTAGE:
+        return channel_open_nb_fail(channel, LIBSSH2_ERROR_CHANNEL_FAILURE,
+            "Channel open failure (resource shortage)");
+    default:
+        return channel_open_nb_fail(channel, LIBSSH2_ERROR_CHANNEL_FAILURE,
+            "Channel open failure");
+    }
+}
+
+/*
+ * Free-time handling of a pipelined open that has not settled. An open the
+ * server may have seen is driven to its reply, so a confirmed channel gets
+ * the ordinary CHANNEL_CLOSE instead of staying open on the server. One the
+ * server cannot have seen is only discarded. Returns EAGAIN or 0.
+ */
+static int channel_open_nb_settle(LIBSSH2_CHANNEL *channel)
+{
+    LIBSSH2_SESSION *session = channel->session;
+    int seen;
+    int rc;
+
+    if(channel->openNB_state == ssh2_NB_state_idle ||
+       channel->openNB_state == ssh2_NB_state_end)
+        return 0;
+
+    seen = channel->openNB_state == ssh2_NB_state_sent1 ||
+        (channel->openNB_state == ssh2_NB_state_sent &&
+         session->packet.olen &&
+         session->packet.odata == channel->openNB_packet);
+    if(seen && session->socket_state == SSH2_SOCKET_CONNECTED) {
+        rc = channel_open_finish(channel);
+        if(rc == LIBSSH2_ERROR_EAGAIN)
+            return rc;
+        /* confirmed: idle, closed below like any channel; otherwise end */
+        return 0;
+    }
+
+    channel_open_nb_release(channel);
+    channel->openNB_state = ssh2_NB_state_end;
+    channel->local.close = 1;
+    channel->remote.close = 1;
+    return 0;
+}
+
+LIBSSH2_CHANNEL *libssh2_channel_open_start(LIBSSH2_SESSION *session,
+                                            const char *channel_type,
+                                            unsigned int channel_type_len,
+                                            unsigned int window_size,
+                                            unsigned int packet_size,
+                                            const char *message,
+                                            unsigned int message_len)
+{
+    unsigned char *copy = NULL;
+
+    if(!session)
+        return NULL;
+    if(!channel_type || (message_len && !message)) {
+        ssh2_err(session, LIBSSH2_ERROR_BAD_USE, "Invalid channel-open input");
+        return NULL;
+    }
+    if(message_len) {
+        copy = SSH2_ALLOC(session, message_len);
+        if(!copy) {
+            ssh2_err(session, LIBSSH2_ERROR_ALLOC,
+                     "Unable to allocate memory for channel-open message");
+            return NULL;
+        }
+        memcpy(copy, message, message_len);
+    }
+    return channel_open_start(session, channel_type, channel_type_len,
+                              window_size, packet_size, copy, message_len);
+}
+
+LIBSSH2_CHANNEL *libssh2_channel_direct_tcpip_start(LIBSSH2_SESSION *session,
+                                                    const char *host,
+                                                    int port,
+                                                    const char *shost,
+                                                    int sport)
+{
+    unsigned char *message;
+    unsigned char *s;
+    size_t host_len;
+    size_t shost_len;
+    size_t message_len;
+
+    if(!session)
+        return NULL;
+    if(!host || !shost) {
+        ssh2_err(session, LIBSSH2_ERROR_BAD_USE, "Invalid direct-tcpip input");
+        return NULL;
+    }
+    host_len = strlen(host);
+    shost_len = strlen(shost);
+    /* host_len(4) + port(4) + shost_len(4) + sport(4) */
+    message_len = host_len + shost_len + 16;
+    s = message = SSH2_ALLOC(session, message_len);
+    if(!message) {
+        ssh2_err(session, LIBSSH2_ERROR_ALLOC,
+                 "Unable to allocate memory for direct-tcpip connection");
+        return NULL;
+    }
+    ssh2_store_str(&s, host, host_len);
+    ssh2_store_u32(&s, port);
+    ssh2_store_str(&s, shost, shost_len);
+    ssh2_store_u32(&s, sport);
+
+    ssh2_deb((session, LIBSSH2_TRACE_CONN,
+              "Requesting pipelined direct-tcpip session from %s:%d to %s:%d",
+              shost, sport, host, port));
+    return channel_open_start(session, "direct-tcpip",
+                              sizeof("direct-tcpip") - 1,
+                              LIBSSH2_CHANNEL_WINDOW_DEFAULT,
+                              LIBSSH2_CHANNEL_PACKET_DEFAULT,
+                              message, message_len);
+}
+
+LIBSSH2_CHANNEL *libssh2_channel_direct_streamlocal_start(
+    LIBSSH2_SESSION *session,
+    const char *socket_path, const char *shost, int sport)
+{
+    unsigned char *message;
+    unsigned char *s;
+    size_t path_len;
+    size_t shost_len;
+    size_t message_len;
+
+    if(!session)
+        return NULL;
+    if(!socket_path || !shost) {
+        ssh2_err(session, LIBSSH2_ERROR_BAD_USE,
+                 "Invalid direct-streamlocal input");
+        return NULL;
+    }
+    path_len = strlen(socket_path);
+    shost_len = strlen(shost);
+    /* path_len(4) + shost_len(4) + sport(4) */
+    message_len = path_len + shost_len + 12;
+    s = message = SSH2_ALLOC(session, message_len);
+    if(!message) {
+        ssh2_err(session, LIBSSH2_ERROR_ALLOC,
+                 "Unable to allocate memory "
+                 "for direct-streamlocal connection");
+        return NULL;
+    }
+    ssh2_store_str(&s, socket_path, path_len);
+    ssh2_store_str(&s, shost, shost_len);
+    ssh2_store_u32(&s, sport);
+
+    ssh2_deb((session, LIBSSH2_TRACE_CONN,
+              "Requesting pipelined direct-streamlocal session to %s",
+              socket_path));
+    return channel_open_start(session, "direct-streamlocal@openssh.com",
+                              sizeof("direct-streamlocal@openssh.com") - 1,
+                              LIBSSH2_CHANNEL_WINDOW_DEFAULT,
+                              LIBSSH2_CHANNEL_PACKET_DEFAULT,
+                              message, message_len);
+}
+
+int libssh2_channel_open_finish(LIBSSH2_CHANNEL *channel)
+{
+    int rc;
+
+    if(!channel)
+        return LIBSSH2_ERROR_BAD_USE;
+
+    BLOCK_ADJUST(rc, channel->session, channel_open_finish(channel));
+    return rc;
+}
+
