diff --git a/src/libssh2_priv.h b/src/libssh2_priv.h
index 5d24403..1777368 100644
--- a/src/libssh2_priv.h
+++ b/src/libssh2_priv.h
@@ -518,6 +518,21 @@ struct _LIBSSH2_CHANNEL {
     ssh2_NB_states reqPTYProcess_state;
     int reqPTYProcess_denied;
 
+    /* Waycar patch: libssh2_channel_open_start()/libssh2_channel_open_finish()
+       keep the open request on the channel rather than in the session's
+       open_* state, so several opens can wait for their replies at once.
+       idle: not a pending open (never was one, or confirmed);
+       created: request built, never handed to the transport;
+       sent: handed to the transport, which may hold it partially sent;
+       sent1: fully sent, waiting for the reply;
+       end: refused or failed, the channel can only be freed. */
+    ssh2_NB_states openNB_state;
+    unsigned char *openNB_packet;
+    size_t openNB_packet_len;
+    unsigned char *openNB_message;
+    size_t openNB_message_len;
+    struct packet_requirev_state openNB_requirev_state;
+
     /* State variables used in libssh2_channel_flush_ex() */
     ssh2_NB_states flush_state;
     size_t flush_refund_bytes;
